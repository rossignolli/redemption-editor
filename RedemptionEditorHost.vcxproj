  </ImportGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <RedemptionVersionBinary>4</RedemptionVersionBinary>
    <TargetName>RedemptionEditorHost</TargetName>
    <OutDir>bin\$(Configuration)\host\</OutDir>
    <IntDir>tmp\$(ProjectName)\$(Configuration)\</IntDir>
    <!-- Third party headers: warnings off (RedemptionEditor.props ExternalWarningLevel). -->
    <ExternalIncludePath>$(MSBuildThisFileDirectory)external\reshade\include;$(MSBuildThisFileDirectory)external\reshade\deps\imgui;$(MSBuildThisFileDirectory)external\reshade\source;$(MSBuildThisFileDirectory)host\third_party\glad\include;$(MSBuildThisFileDirectory)host\third_party\vma;$(MSBuildThisFileDirectory)host\third_party\directx-headers\include;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <Optimization>MaxSpeed</Optimization>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;ImTextureID=ImU64;IMGUI_DISABLE_INCLUDE_IMCONFIG_H;RESHADE_API_LIBRARY_EXPORT;_CRT_SECURE_NO_WARNINGS;NDEBUG;VK_USE_PLATFORM_WIN32_KHR;VMA_STATIC_VULKAN_FUNCTIONS=0;VMA_DYNAMIC_VULKAN_FUNCTIONS=0;VMA_STATS_STRING_ENABLED=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- RESHADE_API_LIBRARY_EXPORT: the ImGui here is the real one (reshade_overlay.hpp forwards to the table without it). -->
      <!-- host\shims comes before external\reshade\source: its dll_log.hpp stands in for ReShade's. -->
      <AdditionalIncludeDirectories>host\shims;host;host\vk;src;external\reshade\include;external\reshade\deps\imgui;external\reshade\source;external\reshade\source\vulkan;host\third_party\glad\include;host\third_party\vma;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ImportLibrary>$(IntDir)$(TargetName).lib</ImportLibrary>
      <!-- imgui_impl_dx12 links d3dcompiler (D3DCompile of its two shaders): loaded only when a D3D12 swapchain draws ImGui.
           dxgi.dll only for ImGui's multi-viewport windows (never enabled): delay loaded, so the host never imports dxgi.dll
           by name (a ReShade dxgi.dll in the game folder must be loaded by the game, when the game wants it).
           dxguid: IID constants (static data, no DLL). -->
      <DelayLoadDLLs>d3dcompiler_47.dll;dxgi.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <AdditionalDependencies>delayimp.lib;dxgi.lib;dxguid.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ModuleDefinitionFile>host\RedemptionEditorHost.def</ModuleDefinitionFile>
      <!-- Only the PDB's file name in the DLL, as the ASI and the core: no build machine path in the release. -->
      <AdditionalOptions>/PDBALTPATH:%25_PDB%25 %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <PostBuildEvent>
      <Command>copy /Y "$(MSBuildThisFileDirectory)host\RedemptionEditorHost.json" "$(OutDir)RedemptionEditorHost.json"</Command>
      <Message>Copying the layer manifest next to RedemptionEditorHost.dll</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <!-- /p:RedemptionDev=true is the developer build (REDEMPTION_DEV). -->
  <ItemDefinitionGroup Condition="'$(RedemptionDev)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>REDEMPTION_DEV;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
