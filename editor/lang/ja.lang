# [shake]
shake.advanced = 詳細
shake.advanced.help = 振幅、速度との連動、重み、静止時に停止、パターン、クロック。
shake.air = 空気の乱れ
shake.amplitude = 振幅
shake.amplitude.help = ノイズ：回転は最大で振幅 x 1度、位置は振幅 x 5 cm。プロファイルの場合：その大きさ（1で調整どおり）。
shake.custom = カスタム
shake.drunk = 酔っぱらい
shake.explosion = 爆発
shake.fade_out = フェードアウト
shake.fade_out.help = カットの場合：次のマーカーの手前0.25秒で揺れがフェードアウトします。
shake.frequency = 周波数
shake.frequency.help = 揺れの速さ（{key_page_up}/{key_page_down}：0.5 Hz）。プロファイルは4 Hzで本来の速さになります。
shake.ground = 地面の振動
shake.gunshot = 銃撃
shake.handheld = 手持ち
shake.horseback = 騎乗
shake.intensity = 強さ
shake.intensity.help = 1～10（5：調整どおりの揺れ）。
shake.pattern = パターン
shake.pattern.help = 同じ数値で別のノイズパターン（Simple CameraのRandomize。毎回同じように再生されます）。
shake.position_weight = 位置の重み
shake.position_weight.help = 揺れがカメラをどれだけ動かすか（0：なし）。
shake.real_time = 実時間
shake.real_time.help = オン：このマーカーのスローモーション中も、揺れは実時間で進みます。オフ：クリップと一緒に遅くなります。
shake.reference_speed = 基準速度
shake.reference_speed.help = 2つの連動で最大とみなすカメラの速度。
shake.restart = ここで再開始
shake.restart.help = パターンとそのフェードインがこのマーカーで最初から始まります（そうでなければ直前のマーカーから揺れが続きます）。
shake.rotation_weight = 回転の重み
shake.rotation_weight.help = 揺れがカメラをどれだけ回すか（0：なし）。
shake.row = 揺れ
shake.row.help = このマーカーから次のマーカーまでのカメラの揺れ：オフ、リアルなプロファイル（手持ち～馬車）、またはSimple Cameraのノイズ（そのプリセット、または詳細の数値を使うカスタム）。爆発と銃撃はこのマーカーで一度だけ揺れます（ここで再開始でもう一度発生します）。
shake.running = 走り
shake.simple_custom = Simple：カスタム
shake.simple_earthquake = Simple：地震
shake.simple_handheld = Simple：手持ち
shake.simple_subtle = Simple：控えめ
shake.simple_vehicle = Simple：乗り物
shake.speed = 揺れの速度
shake.speed.help = 揺れのクロック、5 %～200 %。
shake.speed_amplitude = 速度 > 振幅
shake.speed_amplitude.help = カメラが速く動くほど強くなります：基準速度で x（1 + この値）。
shake.speed_frequency = 速度 > 周波数
shake.speed_frequency.help = カメラが速く動くほど速くなります：基準速度で周波数 x（1 + この値）。
shake.steadicam = ステディカム
shake.still = 静止時に停止
shake.still.help = カメラが静止している間は揺れをフェードアウトします（動くと戻ります）。
shake.transition = トランジション
shake.transition.blend = ブレンド
shake.transition.cut = カット
shake.transition.help = カット：この揺れは次のマーカーまで続きます。ブレンド：数値が次のマーカーの値へなめらかに移ります（Simple CameraのRamp）。部分：古いクリップで一部だけブレンドしたもの。
shake.transition.part = ブレンド（部分）
shake.wagon = 馬車
shake.walking = 歩き

