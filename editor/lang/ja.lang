# [spline]
spline.brackets = " 括弧内：スプラインの既定値。"
spline.curve_shape = 曲線の形
spline.curve_shape.centripetal = " 現在：求心。"
spline.curve_shape.chordal = " 現在：弦長。"
spline.curve_shape.help = Catmull-Romの間隔：0 一様（大きく曲がる）、0.5 求心、1 弦長（短い区間をきつく保つ）。
spline.curve_shape.natural = " ナチュラルプロファイルでは効果なし（マーカーの時刻に沿う曲線には、選ぶ間隔がありません）。"
spline.curve_shape.uniform = " 現在：一様。"
spline.defaults = スプラインの既定値
spline.defaults.help = 独自に設定していないすべてのスプラインマーカーが使う、速度プロファイル、曲線の形、イーズ、カメラの重さ、チャンネル。
spline.defaults.marker_help = 独自に設定していないすべてのマーカーが使う値（RedemptionEditor.iniに保存）。
spline.ease_in = イーズイン
spline.ease_in.help = 区間のうち、静止から加速するのに使う割合（到着時刻は変わりません）。位置、回転、ズーム、構図が一緒にイーズします。
spline.ease_out = イーズアウト
spline.ease_out.help = 区間のうち、次のマーカーで静止するまで減速するのに使う割合。イーズインとイーズアウトの合計が1を超えると縮小されます。
spline.left_past_zero = " 0より左へ：既定値に戻ります。"
spline.position = スプライン位置
spline.position.help = オフ：カメラの位置はマーカー間をまっすぐ進みます（イーズあり）。
spline.profile = 速度プロファイル
spline.profile.continuous = 連続
spline.profile.help = ナチュラル：マーカーの時刻に沿う曲線（急なカーブでは減速）。連続：カメラワーク全体を一定の速度で進み、各マーカーに時刻どおり到着。区間ごと：各区間の中で一定の速度。
spline.profile.natural = ナチュラル
spline.profile.per_segment = 区間ごと
spline.reset_defaults = 既定値をリセット
spline.reset_defaults.help = ナチュラル、曲線の形 1.00、イーズなし、重さなし、全チャンネルオン。RedemptionEditor.iniに保存されます。
spline.rotation = スプライン回転
spline.rotation.help = オフ：回転はマーカー間をまっすぐ変わります（イーズあり）。
spline.types = " {key_select}で数値を入力。"
spline.use_defaults = 既定値を使う
spline.use_defaults.help = このマーカーのすべての行をスプラインの既定値に戻します。
spline.weight = カメラの重さ
spline.weight.help = 曲線をB-splineに近づけます：カメラは質量があるように角の内側を通りますが、マーカーを越えることはありません。再生中と書き出し中のみ有効で、一時停止中はカメラはマーカー上にあります。
spline.zoom = スプラインズーム
spline.zoom.help = オフ：視野角はまっすぐ変化します。オン：目標を行き過ぎて戻ることのない曲線。

# [storage]
storage.body = エディターが保存に使うすべてのフォルダーへの書き込みをWindowsが拒否したため、クリップ、プロジェクト、レポート、変更した設定は保存されません。ゲームフォルダー：{game}。代替フォルダー：{fallback}。いずれかにWindowsアカウントの書き込み権限を与えるか、ゲームをProgram Filesの外へ移動してください。
storage.title = Redemption Editorは何も保存できません

