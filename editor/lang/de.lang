# [settings]
settings.buffer = Replay-Puffer: {state}
settings.buffer.body = Das Spiel nimmt ständig auf, wie der Replay-Modus des Rockstar Editors. {key_save_buffer} speichert, was er hält; {key_record} markiert darin eine Aufnahme.
settings.compress = Clips automatisch komprimieren: {state}
settings.compress.body = Clips, die eine Weile weder abgespielt noch gespeichert wurden, werden im Hintergrund komprimiert, etwa 3-mal kleiner. Sie öffnen sich wie zuvor; das erste Laden dauert einen Sekundenbruchteil länger.
settings.compress_after = Komprimieren nach: {count} {unit}
settings.compress_after.body = Wie lange ein Clip unberührt bleibt, bevor er komprimiert wird. Abspielen oder Speichern zählt als Nutzung.
settings.compress_now = Alte Clips jetzt komprimieren
settings.compress_now.body = Jetzt jeden Clip komprimieren, der älter als die Tage oben ist, ohne zu warten. Läuft im Hintergrund; das Spiel geht weiter.
settings.compress_waiting = Komprimierung wartet...
settings.compressing = Komprimiere {done} von {total}...
settings.cutscenes = Zwischensequenzen: {state}
settings.cutscenes.body = Überspringen: Die Aufnahme pausiert während einer Zwischensequenz und der Clip schneidet direkt darüber hinweg. Aufnehmen: Zwischensequenzen bleiben im Clip.
settings.cutscenes.record = Aufnehmen
settings.cutscenes.skip = Überspringen
settings.day = Tag
settings.days = Tage
settings.dead_eye = Dead Eye im Replay: {state}
settings.dead_eye.body = Das aufgezeichnete Dead Eye und Adlerauge abspielen: den Bildschirmeffekt des Spiels und die Zeitlupe. Aus: Das Replay spielt diese Momente in normalem Tempo, ohne den Effekt.
settings.disk = Clips auf der Festplatte: {size} in {count} Clips, {compressed} komprimiert ({saved} gespart).
settings.disk.reading = Clips auf der Festplatte: Clips werden gelesen...
settings.freeze = Welt bei Pause einfrieren: {state}
settings.freeze.body = An: Ein pausiertes Replay steht still wie im Fotomodus (Feuer, Rauch, Wasser, Stoff, Wind, Umgebungsgeräusche). Aus: Die Welt läuft hinter dem pausierten Replay weiter.
settings.interface_scale = Oberflächengröße: {pct} %
settings.interface_scale.body = Die Größe der Menüs, Felder, Texte und Hinweise des Editors. 100 % sieht bei jeder Auflösung gleich aus; größer liest sich besser aus der Entfernung, kleiner lässt mehr vom Bild frei. Ein 4:3-Bildschirm bleibt bei höchstens 100 %, und ein kleiner Bildschirm geht nicht unter seine 100 %-Größe.
settings.length = Länge: {seconds} Sekunden
settings.length.body = Wie viele Sekunden der Puffer behält. Er hält weniger, wenn die Szene aufwendig ist und zuerst die Speichergrenze greift. Begrenzt keine manuelle Aufnahme ({key_record}).
settings.lock_camera = Kamera in Zwischensequenzen sperren: {state}
settings.lock_camera.body = An: Marker in einer aufgezeichneten Zwischensequenz zeigen deren eigene Kamera. Aus: Die Kameras der Marker wirken dort wie überall sonst.
settings.memory = Speicher: {mb} MB
settings.memory.body = Das Maximum, das der Puffer nutzen darf; eine belebte Stadt braucht etwa 6 MB pro Sekunde. Begrenzt keine manuelle Aufnahme ({key_record}): Eine lange Aufnahme wird in Teilen gespeichert (ManualMaxMB in RedemptionEditor.ini).
settings.rec_indicator = Aufnahmeanzeige: {state}
settings.rec_indicator.body = Der REC-Hinweis, während das Replay aufnimmt. Normal: immer auf dem Bildschirm. Kurz: 3 Sekunden lang, wenn eine Aufnahme beginnt, endet oder gespeichert wird. Für Aufnahmen unsichtbar: Du siehst ihn, Bildschirmrekorder (OBS, NVIDIA, Game Bar) nicht. Aus: kein Hinweis.
settings.rec_indicator.brief = Kurz
settings.rec_indicator.fallback.fullscreen = Das Spiel läuft im exklusiven Vollbild, über dem kein Fenster erscheint: Für Aufnahmen unsichtbar wirkt wie Kurz. Im randlosen Fenster oder im Fenstermodus wird es angezeigt.
settings.rec_indicator.fallback.window = Windows hat das Fenster der Anzeige abgelehnt: Für Aufnahmen unsichtbar wirkt wie Kurz. ReShade.log nennt den Grund.
settings.rec_indicator.fallback.windows = Für Aufnahmen unsichtbar braucht Windows 10 Version 2004 oder neuer: Hier wirkt es wie Kurz.
settings.rec_indicator.hidden = Für Aufnahmen unsichtbar
settings.rec_indicator.normal = Normal
settings.section.interface = OBERFLÄCHE
settings.section.playback = WIEDERGABE
settings.section.recording = AUFNAHME
settings.section.storage = SPEICHER
settings.title = REPLAY-EINSTELLUNGEN

