shake.frequency.help = Wie schnell es wackelt ({key_page_up}/{key_page_down}: ein halbes Hertz). Ein Profil läuft bei 4 Hz in seinem eigenen Tempo.
shake.ground = Bodenvibration
shake.gunshot = Schuss
shake.handheld = Handkamera
shake.horseback = Zu Pferd
shake.intensity = Intensität
shake.intensity.help = 1 bis 10 (5: das Wackeln wie abgestimmt).
shake.pattern = Muster
shake.pattern.help = Ein anderes Rauschmuster mit denselben Zahlen (Randomize aus Simple Camera, bei jeder Wiedergabe gleich).
shake.position_weight = Positionsgewicht
shake.position_weight.help = Wie stark das Wackeln die Kamera bewegt (0: gar nicht).
shake.real_time = Echtzeit
shake.real_time.help = An: Das Wackeln läuft in der Zeitlupe dieses Markers in Echtzeit. Aus: Es wird mit dem Clip langsamer.
shake.reference_speed = Referenztempo
shake.reference_speed.help = Das Kameratempo, das für die zwei Kopplungen als voll zählt.
shake.restart = Hier neu starten
shake.restart.help = Das Muster und sein Einblenden beginnen an diesem Marker neu (sonst läuft das Wackeln vom Marker davor weiter).
shake.rotation_weight = Rotationsgewicht
shake.rotation_weight.help = Wie stark das Wackeln die Kamera dreht (0: gar nicht).
shake.row = Wackeln
shake.row.help = Das Kamerawackeln von diesem Marker bis zum nächsten: aus, ein realistisches Profil (Handkamera bis Wagen) oder das Rauschen aus Simple Camera (seine Vorgaben oder Eigene mit den Zahlen in Erweitert). Explosion und Schuss treffen einmal, an diesem Marker (Hier neu starten löst sie erneut aus).
shake.running = Rennen
shake.simple_custom = Simple: Eigene
shake.simple_earthquake = Simple: Erdbeben
shake.simple_handheld = Simple: Handkamera
shake.simple_subtle = Simple: Dezent
shake.simple_vehicle = Simple: Fahrzeug
shake.speed = Wackeltempo
shake.speed.help = Die Uhr des Wackelns, 5 % bis 200 %.
shake.speed_amplitude = Tempo > Amplitude
shake.speed_amplitude.help = Stärker, je schneller die Kamera fährt: beim Referenztempo x (1 + dieser Wert).
shake.speed_frequency = Tempo > Frequenz
shake.speed_frequency.help = Schneller, je schneller die Kamera fährt: beim Referenztempo Frequenz x (1 + dieser Wert).
shake.steadicam = Steadicam
shake.still = Stopp bei Stillstand
shake.still.help = Das Wackeln ausblenden, während die Kamera stillsteht (wieder einblenden, wenn sie sich bewegt).
shake.transition = Übergang
shake.transition.blend = Überblendung
shake.transition.cut = Schnitt
shake.transition.help = Schnitt: Dieses Wackeln hält bis zum nächsten Marker. Überblendung: Seine Zahlen gehen weich in die des nächsten Markers über (Ramp aus Simple Camera). Teilweise: ein alter Clip, nur teils überblendet.
shake.transition.part = Überblendung (teilw.)
shake.wagon = Wagen
shake.walking = Gehen

