# [hud]
hud.buffer_off = Redemption Editor: Der Replay-Puffer ist aus.
hud.buffer_short = Redemption Editor: Die letzten {saved} Sekunden gespeichert, nicht {asked}: Der Speicher des Replay-Puffers ({mb} MB) füllt sich an belebten Orten schneller. Erhöhe den Speicher in den Replay-Einstellungen, um mehr zu behalten.
hud.cut_failed = Redemption Editor: Dieser Teil der Aufnahme konnte nicht geschnitten werden, daher wurde die manuelle Aufnahme gestoppt.
hud.duplicate = Redemption Editor ist aus: {other} (eine ältere Kopie der Mod) ist auch installiert. Lösche ReplayProbe.asi, ReplayEditor.addon64 und ReplayEditorCore.dll aus dem Spielordner und starte das Spiel neu.
hud.leave_replay = Redemption Editor: Verlasse zuerst das Replay; die Welt kehrt mit deinem letzten Spielstand zurück.
hud.loading = Laden
hud.loading_replay = Replay wird geladen...
hud.loading_world = Laden...
hud.manual_part_size = Redemption Editor: Die Aufnahme hat ihre Größengrenze erreicht, daher wird Teil {part} als eigener Clip gespeichert und die Aufnahme geht in Teil {next} weiter.
hud.manual_part_time = Redemption Editor: Die Aufnahme hat ihre Zeitgrenze erreicht, daher wird Teil {part} als eigener Clip gespeichert und die Aufnahme geht in Teil {next} weiter.
hud.marker_bound_delete = Redemption Editor: Start- und Endmarker begrenzen den Clip; verschiebe sie stattdessen.
hud.marker_bounds = Redemption Editor: Marker gehören zwischen Start- und Endmarker des Clips.
hud.marker_close = Redemption Editor: zu nah an einem anderen Marker.
hud.marker_no_room = Redemption Editor: Dort ist kein Platz für eine Kopie.
hud.move_fit = Redemption Editor: Die Fahrt passt nicht (das Ende des Clips oder sein Endmarker).
hud.move_three = Redemption Editor: Eine Fahrt braucht drei Marker, die ineinander überblenden.
hud.no_memory_changes = Redemption Editor: nicht genug Speicher, um die Änderungen zu speichern. Sie bleiben im offenen Clip.
hud.no_memory_replay = Redemption Editor: nicht genug Speicher, um das Replay zu speichern. Spiele es ab und speichere es im Editor ({key_save}).
hud.paused = Pausiert
hud.pose_editor = Redemption Editor: Schließe zuerst den Pose Editor (er nutzt die Posen der Figuren).
hud.project_clip = {project}  -  Clip {at} von {count}: {clip}
hud.reload_failed = Redemption Editor: Dein letzter Spielstand konnte nicht geladen werden; lade ihn über das Pausenmenü (die Welt wurde für das Replay geleert).
hud.reload_gave_up = Redemption Editor: Die Welt konnte nach dem Replay nicht neu geladen werden; lade deinen letzten Spielstand über das Pausenmenü.
hud.reloaded_in_replay = Redemption Editor: Die Mod wurde während eines Replays neu geladen; dein letzter Spielstand wird jetzt geladen.
hud.report_after_mark = Redemption Editor: Die Problemmarkierung wird abgeschlossen, der Bericht folgt.
hud.report_busy = Redemption Editor: Ein Bericht wird noch gespeichert.
hud.report_failed = Redemption Editor: Der Bericht konnte nicht gespeichert werden ({error}).
hud.report_saved = Bericht gespeichert: {path} ({mb} MB)
hud.report_saved_folder = Bericht gespeichert: {path} (Ordner; die ZIP schlug fehl: {error})
hud.save_failed = Redemption Editor: Das Replay konnte nicht gespeichert werden.
hud.save_held = Redemption Editor: {name} konnte nicht gespeichert werden ({error}). Das Replay bleibt im Speicher und das Speichern wird wiederholt; schaffe etwas Platz auf der Festplatte.
hud.saved_now = Redemption Editor: {name} ist jetzt gespeichert.
hud.saves_failing = Redemption Editor: Das Speichern schlägt fehl, daher wurde die Aufnahme hier gestoppt. Nicht gespeicherte Teile bleiben im Speicher und das Speichern wird wiederholt; schaffe etwas Platz auf der Festplatte.
hud.saves_failing_manual = Redemption Editor: Das Speichern schlägt fehl, daher wurde die manuelle Aufnahme hier gestoppt. Nicht gespeicherte Teile bleiben im Speicher und das Speichern wird wiederholt.
hud.session_reset = Redemption Editor: Das Spiel hat während der Aufnahme geladen; diese Aufnahme wurde verworfen.
hud.world.mission = Redemption Editor: Du bist in einer Mission. Das Replay kann Missionsreste zeigen (zusätzliche Objekte, Türen, Requisiten) und manches sieht vielleicht nicht richtig aus.
hud.world.no_reload = das Neuladen des Spielstands ist nicht verfügbar
hud.world.no_save = kein Spielstand zum Zurückkehren gefunden
hud.world.online = online
hud.world.refused = Redemption Editor: WorldModel=gta hat die Welt nicht geleert ({why}); das Replay läuft wie bisher.
hud.world_cleared = Redemption Editor: Die Welt ist für das Replay geleert; beim Verlassen des Replays wird dein letzter Spielstand geladen.

