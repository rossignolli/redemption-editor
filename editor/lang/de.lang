# [spline]
spline.brackets = " In Klammern: die Spline-Standards."
spline.curve_shape = Kurvenform
spline.curve_shape.centripetal = " Jetzt: Zentripetal."
spline.curve_shape.chordal = " Jetzt: Chordal."
spline.curve_shape.help = Der Catmull-Rom-Abstand: 0 Uniform (weite Kurven), 0.5 Zentripetal, 1 Chordal (hält kurze Abschnitte eng).
spline.curve_shape.natural = " Keine Wirkung mit dem Profil Natürlich (eine Kurve über die Markerzeiten hat keinen Abstand zu wählen)."
spline.curve_shape.uniform = " Jetzt: Uniform."
spline.defaults = Spline-Standards
spline.defaults.help = Tempoprofil, Kurvenform, Anfahren/Abbremsen, Kameragewicht und Kanäle, die jeder Spline-Marker nutzt, sofern er keine eigenen setzt.
spline.defaults.marker_help = Die Werte, die jeder Marker nutzt, sofern er keine eigenen setzt (in RedemptionEditor.ini gespeichert).
spline.ease_in = Anfahren
spline.ease_in.help = Der Anteil des Segments, in dem aus dem Stand beschleunigt wird (die Kamera kommt trotzdem pünktlich an). Position, Rotation, Zoom und Ausschnitt fahren gemeinsam an.
spline.ease_out = Abbremsen
spline.ease_out.help = Der Anteil des Segments, in dem bis zum Stillstand am nächsten Marker abgebremst wird. Anfahren plus Abbremsen über 1 werden herunterskaliert.
spline.left_past_zero = " Links über 0 hinaus: zurück zum Standard."
spline.position = Spline-Position
spline.position.help = Aus: Die Position der Kamera geht gerade zwischen den Markern (mit Anfahren/Abbremsen).
spline.profile = Tempoprofil
spline.profile.continuous = Durchgehend
spline.profile.help = Natürlich: die Kurve über die Markerzeiten (sie wird in engen Kurven langsamer). Durchgehend: ein Tempo durch die ganze Fahrt, jeder Marker pünktlich erreicht. Pro Segment: ein gleichmäßiges Tempo in jedem Segment.
spline.profile.natural = Natürlich
spline.profile.per_segment = Pro Segment
spline.reset_defaults = Standards zurücksetzen
spline.reset_defaults.help = Natürlich, Kurvenform 1.00, kein Anfahren/Abbremsen, kein Gewicht, alle Kanäle an. In RedemptionEditor.ini gespeichert.
spline.rotation = Spline-Rotation
spline.rotation.help = Aus: Die Rotation dreht sich gerade zwischen den Markern (mit Anfahren/Abbremsen).
spline.types = " {key_select}: Zahl eingeben."
spline.use_defaults = Standards nutzen
spline.use_defaults.help = Jede Zeile dieses Markers zurück auf die Spline-Standards.
spline.weight = Kameragewicht
spline.weight.help = Zieht die Kurve Richtung B-spline: Die Kamera schneidet Ecken innen, als hätte sie Masse, nie über einen Marker hinaus. Nur bei Wiedergabe und Export; pausiert sitzt die Kamera auf den Markern.
spline.zoom = Spline-Zoom
spline.zoom.help = Aus: Das Sichtfeld ändert sich gerade. An: eine Kurve, die nie über ihr Ziel hinausschießt und zurückkommt.

# [storage]
storage.body = Windows hat jeden Ordner abgelehnt, in dem der Editor speichert, daher werden Clips, Projekte, Berichte und geänderte Einstellungen nicht behalten. Spielordner: {game}. Ausweichordner: {fallback}. Gib deinem Windows-Konto Schreibrechte für einen davon oder verschiebe das Spiel aus Program Files.
