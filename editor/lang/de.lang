# [tools]
tools.duplicate = Duplizieren
tools.duplicate.help = Eine Kopie auf halbem Weg zum nächsten Marker (2 s nach dem letzten): ein neuer Punkt, um die Kurve zu formen.
tools.even_speed = Tempo angleichen
tools.even_speed.help = Die inneren Marker der Fahrt nach Strecke neu getimt: Die Kamera fährt mit einem Tempo. Der erste und der letzte behalten ihre Zeiten.
tools.even_times = Zeiten angleichen
tools.even_times.help = Die inneren Marker der Fahrt in gleichen Abständen zwischen ihrem ersten und letzten.
tools.lock_all = Alle Marker binden
tools.lock_all.help = Jeder freie Marker des Clips haftet am Ziel, jeder behält seine Ansicht.
tools.lock_mount = Bindungsart
tools.lock_mount.help = Starr dreht sich mit dem Ziel, Standard folgt seiner Ausrichtung, Flexibel nur seiner Position.
tools.lock_move = Diese Fahrt binden
tools.lock_move.help = Jeder Marker der Fahrt haftet am Ziel, jeder behält die Ansicht, die er jetzt zeigt.
tools.lock_target = Bindungsziel
tools.lock_target.help = Die Figur, das Pferd oder das Fahrzeug, an das die Fahrt gebunden wird.
tools.stretch = Fahrt strecken
tools.stretch.help = {key_select} wendet an: Die Fahrt läuft über diesen Anteil ihrer Zeit (über 100% langsamer). Die Handlung bleibt unberührt; Marker nach der Fahrt verschieben sich nur, wenn der Abstand es braucht.
tools.unlock = Diese Fahrt lösen
tools.unlock.help = Die Marker der Fahrt lassen ihr Ziel los und bleiben, wo sie jetzt sind.

