# [hud]
hud.buffer_off = Redemption Editor: il buffer del replay è disattivato.
hud.buffer_short = Redemption Editor: salvati gli ultimi {saved} secondi, non {asked}: la memoria del buffer del replay ({mb} MB) si riempie più in fretta nei luoghi affollati. Aumenta Memoria in Impostazioni replay per conservarne di più.
hud.cut_failed = Redemption Editor: non è stato possibile tagliare questa parte della registrazione, quindi la registrazione manuale si è fermata.
hud.duplicate = Redemption Editor è disattivato: è installato anche {other} (una copia più vecchia della mod). Elimina ReplayProbe.asi, ReplayEditor.addon64 e ReplayEditorCore.dll dalla cartella del gioco e riavvia il gioco.
hud.leave_replay = Redemption Editor: esci prima dal replay; il mondo torna con il tuo ultimo salvataggio.
hud.loading = Caricamento
hud.loading_replay = Caricamento replay...
hud.loading_world = Caricamento...
hud.manual_part_size = Redemption Editor: la registrazione ha raggiunto il limite di dimensione, quindi la parte {part} viene salvata come una clip a sé e la registrazione continua nella parte {next}.
hud.manual_part_time = Redemption Editor: la registrazione ha raggiunto il limite di tempo, quindi la parte {part} viene salvata come una clip a sé e la registrazione continua nella parte {next}.
hud.marker_bound_delete = Redemption Editor: i marcatori di inizio e fine delimitano la clip; spostali invece.
hud.marker_bounds = Redemption Editor: i marcatori vanno tra i marcatori di inizio e fine della clip.
hud.marker_close = Redemption Editor: troppo vicino a un altro marcatore.
hud.marker_no_room = Redemption Editor: non c'è spazio per una copia lì.
hud.move_fit = Redemption Editor: il movimento non ci sta (la fine della clip, o il suo marcatore di fine).
hud.move_three = Redemption Editor: un movimento richiede tre marcatori uniti da fusione.
hud.no_memory_changes = Redemption Editor: memoria insufficiente per salvare le modifiche. Restano nella clip aperta.
hud.no_memory_replay = Redemption Editor: memoria insufficiente per salvare il replay. Riproducilo e salvalo dall'editor ({key_save}).
hud.paused = In pausa
hud.pose_editor = Redemption Editor: chiudi prima il Pose Editor (sta usando le pose del personaggio).
hud.project_clip = {project}  -  clip {at} di {count}: {clip}
hud.reload_failed = Redemption Editor: impossibile caricare il tuo ultimo salvataggio; caricalo dal menu di pausa (il mondo è stato svuotato per il replay).
hud.reload_gave_up = Redemption Editor: impossibile ricaricare il mondo dopo il replay; carica il tuo ultimo salvataggio dal menu di pausa.
hud.reloaded_in_replay = Redemption Editor: la mod è stata ricaricata durante un replay; ora si carica il tuo ultimo salvataggio.
hud.report_after_mark = Redemption Editor: completamento della segnalazione del problema, poi il rapporto.
hud.report_busy = Redemption Editor: un rapporto è ancora in salvataggio.
hud.report_failed = Redemption Editor: impossibile salvare il rapporto ({error}).
hud.report_saved = Rapporto salvato: {path} ({mb} MB)
hud.report_saved_folder = Rapporto salvato: {path} (cartella; lo zip non è riuscito: {error})
hud.save_failed = Redemption Editor: impossibile salvare il replay.
hud.save_held = Redemption Editor: impossibile salvare {name} ({error}). Il replay resta in memoria e il salvataggio viene ripetuto; libera spazio su disco.
hud.saved_now = Redemption Editor: {name} ora è salvato.
hud.saves_failing = Redemption Editor: il salvataggio non riesce, quindi la registrazione si è fermata qui. Le parti non salvate restano in memoria e il salvataggio viene ripetuto; libera spazio su disco.
hud.saves_failing_manual = Redemption Editor: il salvataggio non riesce, quindi la registrazione manuale si è fermata qui. Le parti non salvate restano in memoria e il salvataggio viene ripetuto.
hud.session_reset = Redemption Editor: il gioco ha caricato durante la registrazione; quella registrazione è stata scartata.
hud.world.mission = Redemption Editor: sei in una missione. Il replay potrebbe mostrare residui della missione (oggetti in più, porte, oggetti di scena) e alcune cose potrebbero non apparire corrette.
hud.world.no_reload = il ricaricamento del salvataggio non è disponibile
hud.world.no_save = nessun salvataggio a cui tornare
hud.world.online = online
hud.world.refused = Redemption Editor: WorldModel=gta non ha svuotato il mondo ({why}); il replay funziona come prima.
hud.world_cleared = Redemption Editor: il mondo è svuotato per il replay; uscendo dal replay si carica il tuo ultimo salvataggio.

