# [settings]
settings.buffer = Buffer del replay: {state}
settings.buffer.body = Il gioco registra di continuo, come la modalità replay del Rockstar Editor. {key_save_buffer} salva ciò che contiene; {key_record} segna una registrazione al suo interno.
settings.compress = Compressione automatica clip: {state}
settings.compress.body = Le clip non riprodotte né salvate da un po' vengono compresse in background, circa 3 volte più piccole. Si aprono come prima; il primo caricamento richiede una frazione di secondo in più.
settings.compress_after = Comprimi dopo: {count} {unit}
settings.compress_after.body = Quanto tempo una clip resta inutilizzata prima di essere compressa. Riprodurre o salvare una clip conta come uso.
settings.compress_now = Comprimi ora le clip vecchie
settings.compress_now.body = Comprimi ora ogni clip più vecchia dei giorni indicati sopra, senza aspettare. Funziona in background; il gioco continua.
settings.compress_waiting = Compressione in attesa...
settings.compressing = Compressione {done} di {total}...
settings.cutscenes = Filmati: {state}
settings.cutscenes.body = Salta: la registrazione va in pausa durante un filmato e la clip lo salta direttamente. Registra: i filmati restano nella clip.
settings.cutscenes.record = Registra
settings.cutscenes.skip = Salta
settings.day = giorno
settings.days = giorni
settings.dead_eye = Dead Eye nel replay: {state}
settings.dead_eye.body = Riproduci il Dead Eye e l'Occhio d'aquila registrati: l'effetto sullo schermo del gioco e il rallentatore. Disattivo: il replay riproduce quei momenti a velocità normale, senza l'effetto.
settings.disk = Clip su disco: {size} in {count} clip, {compressed} compresse ({saved} risparmiati).
settings.disk.reading = Clip su disco: lettura delle clip...
settings.freeze = Blocca il mondo in pausa: {state}
settings.freeze.body = Attivo: un replay in pausa resta immobile come nella modalità Foto (fuoco, fumo, acqua, tessuti, vento, suono ambientale). Disattivo: il mondo continua dietro il replay in pausa.
settings.interface_scale = Scala dell'interfaccia: {pct}%
settings.interface_scale.body = La dimensione di menu, pannelli, testi e avvisi dell'editor. Al 100% appare uguale a ogni risoluzione; più grande si legge meglio da lontano, più piccola lascia vedere più immagine. Uno schermo 4:3 resta al massimo al 100%, e uno schermo piccolo non scende sotto la sua dimensione al 100%.
settings.length = Durata: {seconds} secondi
settings.length.body = Quanti secondi conserva il buffer. Ne contiene meno quando la scena è pesante e il limite di memoria arriva prima. Non limita una registrazione manuale ({key_record}).
settings.lock_camera = Blocca la telecamera nei filmati: {state}
settings.lock_camera.body = Attivo: i marcatori dentro un filmato registrato mostrano la telecamera del filmato stesso. Disattivo: le telecamere dei marcatori funzionano lì come altrove.
settings.memory = Memoria: {mb} MB
settings.memory.body = Il massimo che il buffer può usare; una città affollata occupa circa 6 MB al secondo. Non limita una registrazione manuale ({key_record}): una registrazione lunga viene salvata in parti (ManualMaxMB in RedemptionEditor.ini).
settings.rec_indicator = Indicatore di registrazione: {state}
settings.rec_indicator.body = L'avviso REC mentre il replay registra. Normale: sempre a schermo. Breve: per 3 secondi quando una registrazione inizia, si ferma o viene salvata. Nascosto alle catture: tu lo vedi, i registratori dello schermo (OBS, NVIDIA, Game Bar) no. Disattivo: nessun avviso.
settings.rec_indicator.brief = Breve
settings.rec_indicator.fallback.fullscreen = Il gioco è a schermo intero esclusivo, dove nessuna finestra appare sopra: Nascosto alle catture funziona come Breve. In finestra o in finestra senza bordi viene mostrato.
settings.rec_indicator.fallback.window = Windows ha rifiutato la finestra dell'indicatore: Nascosto alle catture funziona come Breve. ReShade.log indica il motivo.
settings.rec_indicator.fallback.windows = Nascosto alle catture richiede Windows 10 versione 2004 o successiva: qui funziona come Breve.
settings.rec_indicator.hidden = Nascosto alle catture
settings.rec_indicator.normal = Normale
