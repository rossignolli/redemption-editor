shake.intensity = 강도
shake.intensity.help = 1~10 (5: 조정된 그대로의 흔들림).
shake.pattern = 패턴
shake.pattern.help = 같은 수치의 다른 노이즈 패턴 (Simple Camera의 Randomize, 재생할 때마다 같음).
shake.position_weight = 위치 가중치
shake.position_weight.help = 흔들림이 카메라를 움직이는 정도 (0: 없음).
shake.real_time = 실시간
shake.real_time.help = 켬: 이 마커의 슬로 모션에서도 흔들림이 실시간을 유지합니다. 끔: 클립과 함께 느려집니다.
shake.reference_speed = 기준 속도
shake.reference_speed.help = 두 연동에서 최대로 치는 카메라 속도.
shake.restart = 여기서 다시 시작
shake.restart.help = 패턴과 페이드 인이 이 마커에서 다시 시작합니다 (아니면 흔들림이 앞 마커에서 이어집니다).
shake.rotation_weight = 회전 가중치
shake.rotation_weight.help = 흔들림이 카메라를 돌리는 정도 (0: 없음).
shake.row = 흔들림
shake.row.help = 이 마커부터 다음 마커까지의 카메라 흔들림: 끔, 사실적인 프로필 (핸드헬드부터 마차까지), 또는 Simple Camera의 노이즈 (프리셋, 또는 고급의 수치를 쓰는 사용자 지정). 폭발과 총격은 이 마커에서 한 번만 흔들립니다 (여기서 다시 시작으로 다시 발생합니다).
shake.running = 달리기
shake.simple_custom = Simple: 사용자 지정
shake.simple_earthquake = Simple: 지진
shake.simple_handheld = Simple: 핸드헬드
shake.simple_subtle = Simple: 미세
shake.simple_vehicle = Simple: 탈것
shake.speed = 흔들림 속도
shake.speed.help = 흔들림의 시계, 5 %~200 %.
shake.speed_amplitude = 속도 > 진폭
shake.speed_amplitude.help = 카메라가 빠를수록 강해집니다: 기준 속도에서 x (1 + 이 값).
shake.speed_frequency = 속도 > 빈도
shake.speed_frequency.help = 카메라가 빠를수록 빨라집니다: 기준 속도에서 빈도 x (1 + 이 값).
shake.steadicam = 스테디캠
shake.still = 정지 시 멈춤
shake.still.help = 카메라가 멈춰 있는 동안 흔들림을 페이드 아웃합니다 (움직이면 돌아옵니다).
shake.transition = 전환
shake.transition.blend = 블렌드
shake.transition.cut = 컷
shake.transition.help = 컷: 이 흔들림이 다음 마커까지 유지됩니다. 블렌드: 수치가 다음 마커의 수치로 부드럽게 바뀝니다 (Simple Camera의 Ramp). 부분: 예전 클립이 일부만 블렌드한 경우.
shake.transition.part = 블렌드 (부분)
shake.wagon = 마차
shake.walking = 걷기

# [span]
span.cut = 잘림: 여기서 녹화가 일시정지됨
span.cutscene = 컷신
span.no_control = 조작 불가
span.script_camera = 스크립트 카메라
span.tip = {kind}: {from}~{to}

# [spline]
spline.brackets = " 괄호 안: 스플라인 기본값."
spline.curve_shape = 곡선 형태
spline.curve_shape.centripetal = " 현재: 구심."
spline.curve_shape.chordal = " 현재: 현 길이."
spline.curve_shape.help = Catmull-Rom 간격: 0 균일 (넓게 도는 곡선), 0.5 구심, 1 현 길이 (짧은 구간을 단단히 유지).
spline.curve_shape.natural = " 자연 프로필에서는 효과 없음 (마커 시간에 따른 곡선에는 고를 간격이 없습니다)."
spline.curve_shape.uniform = " 현재: 균일."
spline.defaults = 스플라인 기본값
spline.defaults.help = 자체 값을 정하지 않은 모든 스플라인 마커가 쓰는 속도 프로필, 곡선 형태, 이즈, 카메라 무게, 채널.
spline.defaults.marker_help = 자체 값을 정하지 않은 모든 마커가 쓰는 값 (RedemptionEditor.ini에 저장).
spline.ease_in = 이즈 인
spline.ease_in.help = 구간 중 정지 상태에서 가속하는 데 쓰는 비율 (도착 시간은 그대로). 위치, 회전, 줌, 구도가 함께 이즈됩니다.
spline.ease_out = 이즈 아웃
spline.ease_out.help = 구간 중 다음 마커에서 멈추도록 감속하는 데 쓰는 비율. 이즈 인과 이즈 아웃의 합이 1을 넘으면 비율대로 줄어듭니다.
spline.left_past_zero = " 0에서 더 왼쪽: 기본값으로 돌아갑니다."
spline.position = 스플라인 위치
spline.position.help = 끔: 카메라 위치가 마커 사이를 직선으로 이동합니다 (이즈 적용).
spline.profile = 속도 프로필
spline.profile.continuous = 연속
spline.profile.help = 자연: 마커 시간에 따른 곡선 (급한 굽이에서 느려짐). 연속: 카메라 이동 전체가 한 속도이며, 모든 마커에 제시간에 도착. 구간별: 각 구간 안에서 고른 속도.
spline.profile.natural = 자연
spline.profile.per_segment = 구간별
spline.reset_defaults = 기본값 초기화
spline.reset_defaults.help = 자연, 곡선 형태 1.00, 이즈 없음, 무게 없음, 모든 채널 켬. RedemptionEditor.ini에 저장.
spline.rotation = 스플라인 회전
spline.rotation.help = 끔: 회전이 마커 사이를 직선으로 바뀝니다 (이즈 적용).
spline.types = " {key_select}로 숫자를 입력합니다."
spline.use_defaults = 기본값 사용
spline.use_defaults.help = 이 마커의 모든 행을 스플라인 기본값으로 되돌립니다.
spline.weight = 카메라 무게
spline.weight.help = 곡선을 B-spline 쪽으로 당깁니다: 카메라가 질량이 있는 것처럼 모서리 안쪽으로 돌지만 마커를 넘지는 않습니다. 재생과 내보내기 중에만 적용되며, 일시정지 중에는 카메라가 마커 위에 있습니다.
spline.zoom = 스플라인 줌
spline.zoom.help = 끔: 시야각이 직선으로 바뀝니다. 켬: 목표값을 넘었다가 되돌아오지 않는 곡선.

# [storage]
storage.body = Windows가 에디터가 저장하는 모든 폴더를 거부해 클립, 프로젝트, 보고서, 변경한 설정이 보관되지 않습니다. 게임 폴더: {game}. 대체 폴더: {fallback}. 이 중 하나에 Windows 계정의 쓰기 권한을 주거나 게임을 Program Files 밖으로 옮기세요.
storage.title = Redemption Editor가 아무것도 저장할 수 없습니다

# [target]
target.not_in_clip = (클립에 없음)

# [tools]
tools.duplicate = 복제
tools.duplicate.help = 다음 마커까지의 중간 지점에 복사본을 만듭니다 (마지막 마커 뒤에서는 2 s 뒤): 곡선을 다듬을 새 지점.
tools.even_speed = 속도 균일화
tools.even_speed.help = 카메라 이동의 안쪽 마커를 거리에 맞춰 시간 재조정합니다: 카메라가 한 속도로 이동합니다. 처음과 마지막 마커는 시간을 유지합니다.
tools.even_times = 시간 균일화
tools.even_times.help = 카메라 이동의 안쪽 마커를 처음과 마지막 마커 사이에 같은 간격으로 배치합니다.
tools.lock_all = 모든 마커 고정
tools.lock_all.help = 클립의 모든 자유 마커가 각자 시점을 유지하며 대상을 따라갑니다.
tools.lock_mount = 고정 마운트
tools.lock_mount.help = 밀착은 대상과 함께 회전하고, 기본값은 대상의 방향을 따르며, 유연은 위치만 따릅니다.
tools.lock_move = 이 카메라 이동 고정
tools.lock_move.help = 카메라 이동의 모든 마커가 지금 보이는 시점을 유지하며 대상을 따라갑니다.
tools.lock_target = 고정 대상
tools.lock_target.help = 카메라 이동을 고정할 캐릭터, 말 또는 탈것.
tools.stretch = 카메라 이동 늘이기
tools.stretch.help = {key_select}로 적용: 카메라 이동이 원래 시간의 이 비율 동안 재생됩니다 (100% 초과 시 느려짐). 동작은 건드리지 않으며, 카메라 이동 뒤의 마커는 간격이 필요할 때만 옮겨집니다.
tools.unlock = 이 카메라 이동 고정 해제
tools.unlock.help = 카메라 이동의 마커가 대상을 놓고 지금 보이는 자리에 남습니다.

