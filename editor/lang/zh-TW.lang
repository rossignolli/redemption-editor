# [shake]
shake.advanced = 進階
shake.advanced.help = 振幅、速度連動、權重、靜止時停止、模式、時脈。
shake.air = 空中亂流
shake.amplitude = 振幅
shake.amplitude.help = 雜訊：旋轉最多振幅 x 1 度，位置為振幅 x 5 cm。設定檔：其大小（1 為原調校）。
shake.custom = 自訂
shake.drunk = 酒醉
shake.explosion = 爆炸
shake.fade_out = 淡出
shake.fade_out.help = 搭配切換：晃動會在下一個標記前的最後四分之一秒淡出。
shake.frequency = 頻率
shake.frequency.help = 晃動的快慢（{key_page_up}/{key_page_down}：半赫茲）。設定檔在 4 Hz 時以自身速度播放。
shake.ground = 地面震動
shake.gunshot = 槍擊
shake.handheld = 手持
shake.horseback = 騎馬
shake.intensity = 強度
shake.intensity.help = 1 至 10（5：原調校的晃動）。
shake.pattern = 模式
shake.pattern.help = 使用相同數值的另一種雜訊模式（Simple Camera 的 Randomize，每次播放都相同）。
shake.position_weight = 位置權重
shake.position_weight.help = 晃動移動鏡頭的程度（0：無）。
shake.real_time = 即時
shake.real_time.help = 開啟：在此標記的慢動作中晃動維持即時速度。關閉：隨片段一起變慢。
shake.reference_speed = 參考速度
shake.reference_speed.help = 兩種連動中視為全速的鏡頭速度。
shake.restart = 由此重新開始
shake.restart.help = 模式及其淡入會在此標記重新開始（否則晃動會從前一個標記延續）。
shake.rotation_weight = 旋轉權重
shake.rotation_weight.help = 晃動轉動鏡頭的程度（0：無）。
shake.row = 晃動
shake.row.help = 從此標記到下一個標記的鏡頭晃動：關閉、寫實設定檔（手持到馬車），或 Simple Camera 的雜訊（其預設，或使用進階中數值的自訂）。爆炸和槍擊只在此標記衝擊一次（由此重新開始可再次觸發）。
shake.running = 奔跑
shake.simple_custom = Simple：自訂
shake.simple_earthquake = Simple：地震
shake.simple_handheld = Simple：手持
shake.simple_subtle = Simple：輕微
shake.simple_vehicle = Simple：載具
shake.speed = 晃動速度
shake.speed.help = 晃動的時脈，5 % 至 200 %。
shake.speed_amplitude = 速度 > 振幅
shake.speed_amplitude.help = 鏡頭移動越快越強：在參考速度時為 x（1 + 此值）。
shake.speed_frequency = 速度 > 頻率
shake.speed_frequency.help = 鏡頭移動越快越快：在參考速度時頻率為 x（1 + 此值）。
shake.steadicam = 穩定器
shake.still = 靜止時停止
shake.still.help = 鏡頭靜止時晃動淡出（移動時恢復）。
shake.transition = 轉場
shake.transition.blend = 混合
shake.transition.cut = 切換
shake.transition.help = 切換：此晃動維持到下一個標記。混合：其數值平滑過渡到下一個標記的數值（Simple Camera 的 Ramp）。部分：舊片段只混合了部分數值。
shake.transition.part = 混合（部分）
shake.wagon = 馬車
shake.walking = 步行

# [span]
span.cut = 剪接：錄影在此暫停
span.cutscene = 過場動畫
span.no_control = 無法操控
span.script_camera = 腳本鏡頭
span.tip = {kind}：{from} 至 {to}

# [spline]
spline.brackets = " 括號內：Spline 預設值。"
spline.curve_shape = 曲線形狀
spline.curve_shape.centripetal = " 目前：向心。"
spline.curve_shape.chordal = " 目前：弦長。"
spline.curve_shape.help = Catmull-Rom 的參數間距：0 均勻（大彎），0.5 向心，1 弦長（短段保持緊湊）。
spline.curve_shape.natural = " 使用自然速度曲線時無效（依標記時間的曲線沒有間距可選）。"
spline.curve_shape.uniform = " 目前：均勻。"
spline.defaults = Spline 預設值
spline.defaults.help = 每個 Spline 標記在未自行設定時使用的速度曲線、曲線形狀、緩動、鏡頭重量與通道。
spline.defaults.marker_help = 每個標記在未自行設定時使用的數值（儲存在 RedemptionEditor.ini）。
spline.ease_in = 緩入
spline.ease_in.help = 此段中從靜止加速所佔的比例（仍會準時抵達）。位置、旋轉、縮放與構圖會一起緩動。
spline.ease_out = 緩出
spline.ease_out.help = 此段中減速至下一個標記停止所佔的比例。緩入加緩出超過 1 時會等比縮小。
spline.left_past_zero = " 向左超過 0：恢復預設值。"
spline.position = Spline 位置
spline.position.help = 關閉：鏡頭位置在標記之間直線移動（含緩動）。
spline.profile = 速度曲線
spline.profile.continuous = 連續
spline.profile.help = 自然：依標記時間的曲線（在急彎處減速）。連續：整段運鏡維持一種速度，準時抵達每個標記。分段：每一段內等速。
spline.profile.natural = 自然
spline.profile.per_segment = 分段
spline.reset_defaults = 重設預設值
spline.reset_defaults.help = 自然、曲線形狀 1.00、無緩動、無重量、所有通道開啟。儲存在 RedemptionEditor.ini。
spline.rotation = Spline 旋轉
spline.rotation.help = 關閉：旋轉在標記之間直線轉動（含緩動）。
spline.types = " 按 {key_select} 可輸入數字。"
spline.use_defaults = 使用預設值
spline.use_defaults.help = 此標記的每一列恢復為 Spline 預設值。
spline.weight = 鏡頭重量
spline.weight.help = 將曲線拉向 B-spline：鏡頭會像有質量一樣切過彎角內側，但絕不越過標記。僅在播放與匯出時作用；暫停時鏡頭停在標記上。
spline.zoom = Spline 縮放
spline.zoom.help = 關閉：視野直線變化。開啟：一條絕不超過目標再折返的曲線。

# [storage]
storage.body = Windows 拒絕了編輯器用來儲存的所有資料夾，因此片段、專案、報告和變更的設定都不會保留。遊戲資料夾：{game}。備用資料夾：{fallback}。請為你的 Windows 帳戶授予其中一個資料夾的寫入權限，或將遊戲移出 Program Files。
storage.title = Redemption Editor 無法儲存任何內容

