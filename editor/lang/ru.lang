# [spline]
spline.brackets = " В скобках: «Сплайн по умолчанию»."
spline.curve_shape = Форма кривой
spline.curve_shape.centripetal = " Сейчас: центростремительная."
spline.curve_shape.chordal = " Сейчас: хордовая."
spline.curve_shape.help = Шаг Catmull-Rom: 0 равномерная (широкие повороты), 0.5 центростремительная, 1 хордовая (плотно держит короткие участки).
spline.curve_shape.natural = " Не действует с профилем «Естественный» (у кривой по времени маркеров нет шага для выбора)."
spline.curve_shape.uniform = " Сейчас: равномерная."
spline.defaults = Сплайн по умолчанию
spline.defaults.help = Профиль скорости, форма кривой, разгон и торможение, вес камеры и каналы, которые использует каждый маркер со сплайном, если не задал свои.
spline.defaults.marker_help = Значения, которые использует каждый маркер, если не задал свои (хранятся в RedemptionEditor.ini).
spline.ease_in = Разгон
spline.ease_in.help = Доля отрезка на разгон с места (камера всё равно приходит вовремя). Позиция, поворот, зум и компоновка разгоняются вместе.
spline.ease_out = Торможение
spline.ease_out.help = Доля отрезка на торможение до остановки у следующего маркера. Если разгон и торможение в сумме больше 1, они уменьшаются.
spline.left_past_zero = " Влево за 0: обратно к значению по умолчанию."
spline.position = Сплайн: позиция
spline.position.help = Выкл.: позиция камеры идёт по прямой между маркерами (с разгоном и торможением).
spline.profile = Профиль скорости
spline.profile.continuous = Непрерывный
spline.profile.help = Естественный: кривая по времени маркеров (замедляется в крутых изгибах). Непрерывный: одна скорость на всё движение, каждый маркер вовремя. По отрезкам: ровная скорость внутри каждого отрезка.
spline.profile.natural = Естественный
spline.profile.per_segment = По отрезкам
spline.reset_defaults = Сбросить по умолчанию
spline.reset_defaults.help = Естественный, форма кривой 1.00, без разгона и торможения, без веса, все каналы вкл. Хранится в RedemptionEditor.ini.
spline.rotation = Сплайн: поворот
spline.rotation.help = Выкл.: поворот идёт по прямой между маркерами (с разгоном и торможением).
spline.types = " {key_select}: ввести число."
spline.use_defaults = Взять по умолчанию
spline.use_defaults.help = Все строки этого маркера вернуть к «Сплайн по умолчанию».
spline.weight = Вес камеры
spline.weight.help = Тянет кривую к B-spline: камера срезает углы, будто у неё есть масса, но никогда не проходит мимо маркера. Только при воспроизведении и экспорте; на паузе камера стоит на маркерах.
spline.zoom = Сплайн: зум
spline.zoom.help = Выкл.: поле зрения меняется по прямой. Вкл.: кривая, которая никогда не проскакивает цель и не возвращается.

# [storage]
storage.body = Windows запретила запись во все папки, куда сохраняет редактор, поэтому клипы, проекты, отчёты и изменённые настройки не сохраняются. Папка игры: {game}. Запасные папки: {fallback}. Дайте своей учётной записи Windows право записи в одну из них или перенесите игру из Program Files.
storage.title = Redemption Editor не может ничего сохранить

# [target]
target.not_in_clip = (нет в клипе)

# [tools]
tools.duplicate = Дублировать
tools.duplicate.help = Копия на полпути до следующего маркера (после последнего: через 2 s): новая точка для формы кривой.
tools.even_speed = Выровнять скорость
tools.even_speed.help = Внутренние маркеры движения переставляются по расстоянию: камера летит с одной скоростью. Первый и последний сохраняют своё время.
tools.even_times = Выровнять время
tools.even_times.help = Внутренние маркеры движения через равные промежутки между первым и последним.
tools.lock_all = Привязать все маркеры
tools.lock_all.help = Каждый свободный маркер клипа движется с целью, сохраняя свой вид.
tools.lock_mount = Крепление привязки
tools.lock_mount.help = Жёсткий поворачивается с целью, стандартный следует за её курсом, гибкий только за её позицией.
tools.lock_move = Привязать это движение
tools.lock_move.help = Каждый маркер движения движется с целью, сохраняя вид, который показывает сейчас.
tools.lock_target = Цель привязки
tools.lock_target.help = Персонаж, лошадь или транспорт, к которому привязывается движение.
tools.stretch = Растянуть движение
tools.stretch.help = {key_select} применяет: движение идёт за эту долю своего времени (больше 100%: медленнее). Действие не меняется; маркеры после движения сдвигаются, только если нужен промежуток.
tools.unlock = Отвязать это движение
tools.unlock.help = Маркеры движения отпускают цель и остаются там, где показывают сейчас.

