# [tools]
tools.duplicate = Duplicar
tools.duplicate.help = Una copia a medio camino del marcador siguiente (2 s después tras el último): un punto nuevo para dar forma a la curva.
tools.even_speed = Igualar velocidad
tools.even_speed.help = Los marcadores interiores del movimiento se reajustan en el tiempo por distancia: la cámara va a una sola velocidad. El primero y el último mantienen sus tiempos.
tools.even_times = Igualar tiempos
tools.even_times.help = Los marcadores interiores del movimiento a tiempos iguales entre el primero y el último.
tools.lock_all = Fijar todos los marcadores
tools.lock_all.help = Todos los marcadores libres del clip van con el objetivo, cada uno con su vista.
tools.lock_mount = Montaje al fijar
tools.lock_mount.help = Rígido gira con el objetivo, Predeterminado sigue su rumbo, Flexible solo su posición.
tools.lock_move = Fijar este movimiento
tools.lock_move.help = Todos los marcadores del movimiento van con el objetivo, cada uno con la vista que muestra ahora.
tools.lock_target = Objetivo al fijar
tools.lock_target.help = El personaje, caballo o vehículo al que se fija el movimiento.
tools.stretch = Estirar movimiento
tools.stretch.help = {key_select} aplica: el movimiento se reproduce en esta parte de su tiempo (más del 100%: más lento). La acción no se toca; los marcadores posteriores al movimiento solo se mueven cuando el espaciado lo necesita.
tools.unlock = Soltar este movimiento
tools.unlock.help = Los marcadores del movimiento sueltan su objetivo y se quedan donde se ven ahora.

