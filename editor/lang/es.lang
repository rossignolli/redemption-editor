shake.gunshot = Disparo
shake.handheld = Cámara en mano
shake.horseback = A caballo
shake.intensity = Intensidad
shake.intensity.help = De 1 a 10 (5: el temblor como está ajustado).
shake.pattern = Patrón
shake.pattern.help = Otro patrón de ruido con los mismos números (el Randomize de Simple Camera, igual en cada reproducción).
shake.position_weight = Peso de la posición
shake.position_weight.help = Cuánto mueve el temblor la cámara (0: nada).
shake.real_time = Tiempo real
shake.real_time.help = Activado: el temblor mantiene el tiempo real en la cámara lenta de este marcador. Desactivado: se ralentiza con el clip.
shake.reference_speed = Velocidad de referencia
shake.reference_speed.help = La velocidad de cámara que cuenta como completa para los dos acoplamientos.
shake.restart = Reiniciar aquí
shake.restart.help = El patrón y su entrada empiezan de nuevo en este marcador (si no, el temblor sigue desde el marcador anterior).
shake.rotation_weight = Peso de la rotación
shake.rotation_weight.help = Cuánto gira el temblor la cámara (0: nada).
shake.row = Temblor
shake.row.help = El temblor de cámara desde este marcador hasta el siguiente: desactivado, un perfil realista (de Cámara en mano a Carromato) o el ruido de Simple Camera (sus preajustes, o Personalizado con los números de Avanzado). Explosión y Disparo golpean una vez, en este marcador (Reiniciar aquí los vuelve a disparar).
shake.running = Corriendo
shake.simple_custom = Simple: personalizado
shake.simple_earthquake = Simple: terremoto
shake.simple_handheld = Simple: cámara en mano
shake.simple_subtle = Simple: sutil
shake.simple_vehicle = Simple: vehículo
shake.speed = Velocidad del temblor
shake.speed.help = El reloj del temblor, del 5 % al 200 %.
shake.speed_amplitude = Velocidad > Amplitud
shake.speed_amplitude.help = Más fuerte cuanto más rápido se mueve la cámara: a la velocidad de referencia, x (1 + esto).
shake.speed_frequency = Velocidad > Frecuencia
shake.speed_frequency.help = Más rápido cuanto más rápido se mueve la cámara: a la velocidad de referencia, frecuencia x (1 + esto).
shake.steadicam = Steadicam
shake.still = Parar si está quieta
shake.still.help = Desvanece el temblor mientras la cámara está quieta (vuelve cuando se mueve).
shake.transition = Transición
shake.transition.blend = Fusión
shake.transition.cut = Corte
shake.transition.help = Corte: este temblor se mantiene hasta el marcador siguiente. Fusión: sus números pasan suavemente a los del marcador siguiente (el Ramp de Simple Camera). Parcial: un clip antiguo fusionaba solo algunos.
shake.transition.part = Fusión (parcial)
shake.wagon = Carromato
shake.walking = Caminando

