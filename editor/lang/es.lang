# [spline]
spline.brackets = " Entre corchetes: los Valores de spline."
spline.curve_shape = Forma de la curva
spline.curve_shape.centripetal = " Ahora: centrípeta."
spline.curve_shape.chordal = " Ahora: cordal."
spline.curve_shape.help = El espaciado de Catmull-Rom: 0 uniforme (curvas abiertas), 0.5 centrípeta, 1 cordal (ciñe los tramos cortos).
spline.curve_shape.natural = " Sin efecto con el perfil Natural (una curva sobre los tiempos de los marcadores no tiene espaciado que elegir)."
spline.curve_shape.uniform = " Ahora: uniforme."
spline.defaults = Valores de spline
spline.defaults.help = Perfil de velocidad, forma de la curva, suavizado, peso de la cámara y canales que usa cada marcador Spline salvo que tenga los suyos.
spline.defaults.marker_help = Los valores que usa cada marcador salvo que tenga los suyos (se guardan en RedemptionEditor.ini).
spline.ease_in = Suavizado de entrada
spline.ease_in.help = La parte del tramo que se dedica a acelerar desde parado (aun así llega a tiempo). Posición, rotación, zoom y encuadre se suavizan juntos.
spline.ease_out = Suavizado de salida
spline.ease_out.help = La parte del tramo que se dedica a frenar hasta parar en el marcador siguiente. Si Suavizado de entrada más Suavizado de salida pasan de 1, se reducen.
spline.left_past_zero = " Izquierda por debajo de 0: vuelve al predeterminado."
spline.position = Posición en spline
spline.position.help = Desactivado: la posición de la cámara va en línea recta entre los marcadores (con el suavizado).
spline.profile = Perfil de velocidad
spline.profile.continuous = Continuo
spline.profile.help = Natural: la curva sobre los tiempos de los marcadores (frena en las curvas cerradas). Continuo: una sola velocidad en todo el movimiento, llegando a tiempo a cada marcador. Por tramo: una velocidad uniforme dentro de cada tramo.
spline.profile.natural = Natural
spline.profile.per_segment = Por tramo
spline.reset_defaults = Restablecer valores
spline.reset_defaults.help = Natural, Forma de la curva 1.00, sin suavizado, sin peso, todos los canales activados. Se guarda en RedemptionEditor.ini.
spline.rotation = Rotación en spline
spline.rotation.help = Desactivado: la rotación gira en línea recta entre los marcadores (con el suavizado).
spline.types = " {key_select} para escribir un número."
spline.use_defaults = Usar valores de spline
spline.use_defaults.help = Todas las filas de este marcador vuelven a los Valores de spline.
spline.weight = Peso de la cámara
spline.weight.help = Acerca la curva a una B-spline: la cámara recorta por dentro de las esquinas como si tuviera masa, sin pasarse nunca de un marcador. Solo al reproducir y exportar; en pausa, la cámara se queda en los marcadores.
spline.zoom = Zoom en spline
spline.zoom.help = Desactivado: el campo de visión cambia en línea recta. Activado: una curva que nunca se pasa de su objetivo y vuelve.

# [storage]
storage.body = Windows rechazó todas las carpetas donde guarda el editor, así que no se conservan clips, proyectos, informes ni ajustes cambiados. Carpeta del juego: {game}. Carpetas alternativas: {fallback}. Da a tu cuenta de Windows permiso de escritura en una de ellas o saca el juego de Program Files.
storage.title = Redemption Editor no puede guardar nada

