# [settings]
settings.buffer = Búfer de repetición: {state}
settings.buffer.body = El juego graba todo el tiempo, como el modo de repetición del Editor de Rockstar. {key_save_buffer} guarda lo que contiene; {key_record} marca una grabación dentro de él.
settings.compress = Comprimir clips automáticamente: {state}
settings.compress.body = Los clips que no se reproducen ni se guardan durante un tiempo se comprimen en segundo plano, unas 3 veces más pequeños. Se abren igual que antes; la primera carga tarda una fracción de segundo más.
settings.compress_after = Comprimir tras: {count} {unit}
settings.compress_after.body = Cuánto tiempo pasa un clip sin usarse antes de comprimirse. Reproducir o guardar un clip cuenta como uso.
settings.compress_now = Comprimir ya los clips antiguos
settings.compress_now.body = Comprime ya todos los clips más antiguos que los días de arriba, sin esperar. Se hace en segundo plano; el juego sigue.
settings.compress_waiting = Compresión en espera...
settings.compressing = Comprimiendo {done} de {total}...
settings.cutscenes = Cinemáticas: {state}
settings.cutscenes.body = Omitir: la grabación se pausa mientras se reproduce una cinemática y el clip la salta. Grabar: las cinemáticas se quedan en el clip.
settings.cutscenes.record = Grabar
settings.cutscenes.skip = Omitir
settings.day = día
settings.days = días
settings.dead_eye = Dead Eye en la repetición: {state}
settings.dead_eye.body = Reproduce el Dead Eye y el Ojo de Águila grabados: el efecto de pantalla del juego y la cámara lenta. Desactivado: la repetición reproduce esos momentos a velocidad normal, sin el efecto.
settings.disk = Clips en disco: {size} en {count} clips, {compressed} comprimidos ({saved} ahorrados).
settings.disk.reading = Clips en disco: leyendo clips...
settings.freeze = Congelar el mundo en pausa: {state}
settings.freeze.body = Activado: una repetición en pausa se queda quieta como en el modo foto (fuego, humo, agua, ropa, viento, sonido ambiente). Desactivado: el mundo sigue detrás de la repetición en pausa.
settings.interface_scale = Escala de la interfaz: {pct}%
settings.interface_scale.body = El tamaño de los menús, paneles, textos y avisos del editor. Al 100% se ve igual en cualquier resolución; más grande se lee mejor de lejos, más pequeño deja ver más imagen. Una pantalla 4:3 se queda en el 100% como máximo, y una pantalla pequeña no baja de su tamaño al 100%.
settings.length = Duración: {seconds} segundos
settings.length.body = Cuántos segundos guarda el búfer. Guarda menos cuando la escena es pesada y antes se llega al límite de memoria. No limita una grabación manual ({key_record}).
settings.lock_camera = Bloquear cámara en cinemáticas: {state}
settings.lock_camera.body = Activado: los marcadores dentro de una cinemática grabada muestran la cámara de la propia cinemática. Desactivado: las cámaras de los marcadores funcionan ahí como en cualquier otro sitio.
settings.memory = Memoria: {mb} MB
settings.memory.body = Lo máximo que puede usar el búfer; una ciudad concurrida ocupa unos 6 MB por segundo. No limita una grabación manual ({key_record}): una grabación larga se guarda en partes (ManualMaxMB en RedemptionEditor.ini).
settings.rec_indicator = Indicador de grabación: {state}
settings.rec_indicator.body = El aviso REC mientras la repetición graba. Normal: siempre en pantalla. Breve: 3 segundos cuando una grabación empieza, termina o se guarda. Oculto en capturas: tú lo ves, los grabadores de pantalla (OBS, NVIDIA, Game Bar) no. Desactivado: sin aviso.
settings.rec_indicator.brief = Breve
settings.rec_indicator.fallback.fullscreen = El juego está en pantalla completa exclusiva, donde ninguna ventana se muestra encima: Oculto en capturas funciona como Breve. En ventana o en ventana sin bordes sí se muestra.
settings.rec_indicator.fallback.window = Windows rechazó la ventana del indicador: Oculto en capturas funciona como Breve. ReShade.log indica el motivo.
settings.rec_indicator.fallback.windows = Oculto en capturas necesita Windows 10 versión 2004 o posterior: aquí funciona como Breve.
settings.rec_indicator.hidden = Oculto en capturas
settings.rec_indicator.normal = Normal
settings.section.interface = INTERFAZ
settings.section.playback = REPRODUCCIÓN
settings.section.recording = GRABACIÓN
settings.section.storage = ALMACENAMIENTO
settings.title = AJUSTES DE REPETICIÓN

