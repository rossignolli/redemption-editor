# [settings]
settings.buffer = Replay Buffer: {state}
settings.buffer.body = The game records all the time, like the Rockstar Editor's replay mode. {key_save_buffer} saves what it holds; {key_record} marks a recording inside it.
settings.compress = Auto-compress clips: {state}
settings.compress.body = Clips not played nor saved for a while are compressed in the background, about 3 times smaller. They open as before; the first load takes a fraction of a second more.
settings.compress_after = Compress after: {count} {unit}
settings.compress_after.body = How long a clip stays untouched before it is compressed. Playing or saving a clip counts as a use.
settings.compress_now = Compress old clips now
settings.compress_now.body = Compress now every clip older than the days above, without waiting. It runs in the background; the game keeps going.
settings.compress_waiting = Compression waiting...
settings.compressing = Compressing {done} of {total}...
settings.cutscenes = Cutscenes: {state}
settings.cutscenes.body = Skip: the recording pauses while a cutscene plays and the clip cuts straight past it. Record: cutscenes are kept in the clip.
settings.cutscenes.record = Record
settings.cutscenes.skip = Skip
settings.day = day
settings.days = days
settings.dead_eye = Dead Eye in replay: {state}
settings.dead_eye.body = Play the recorded Dead Eye and Eagle Eye: the game's screen effect and the slow motion. Off: the replay plays those moments at normal speed, without the effect.
settings.disk = Clips on disk: {size} in {count} clips, {compressed} compressed ({saved} saved).
settings.disk.reading = Clips on disk: reading clips...
settings.freeze = Freeze world when paused: {state}
settings.freeze.body = On: a paused replay stands still like the photo mode (fire, smoke, water, cloth, wind, ambient sound). Off: the world goes on behind the paused replay.
settings.interface_scale = Interface scale: {pct}%
settings.interface_scale.body = The size of the editor's menus, panels, texts and notices. 100% looks the same at every resolution; larger reads better from a distance, smaller leaves more of the picture. A 4:3 screen stays at 100% at most, and a small screen does not go below its 100% size.
settings.length = Length: {seconds} seconds
settings.length.body = How many seconds the buffer keeps. It holds less when the scene is heavy and the memory limit comes first. A manual recording ({key_record}) is not limited by it.
settings.lock_camera = Lock camera in cutscenes: {state}
settings.lock_camera.body = On: markers inside a recorded cutscene show the cutscene's own camera. Off: the markers' cameras work there as anywhere else.
settings.memory = Memory: {mb} MB
settings.memory.body = The most the buffer may use; a busy town takes about 6 MB a second. A manual recording ({key_record}) is not limited by it: a long one is saved in parts (ManualMaxMB in RedemptionEditor.ini).
settings.rec_indicator = Recording indicator: {state}
settings.rec_indicator.body = The REC notice while the replay records. Normal: always on screen. Brief: for 3 seconds when a recording starts, stops or saves. Hidden from capture: you see it, screen recorders (OBS, NVIDIA, Game Bar) do not. Off: no notice.
settings.rec_indicator.brief = Brief
