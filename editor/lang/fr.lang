tools.duplicate = Dupliquer
tools.duplicate.help = Une copie à mi-chemin du marqueur suivant (2 s plus loin après le dernier): un nouveau point pour façonner la courbe.
tools.even_speed = Égaliser la vitesse
tools.even_speed.help = Les marqueurs intérieurs du mouvement recalés selon la distance: la caméra avance à une seule vitesse. Le premier et le dernier gardent leurs temps.
tools.even_times = Égaliser les temps
tools.even_times.help = Les marqueurs intérieurs du mouvement à intervalles égaux entre le premier et le dernier.
tools.lock_all = Verrouiller tous les marqueurs
tools.lock_all.help = Chaque marqueur libre du clip est fixé à la cible, chacun gardant sa vue.
tools.lock_mount = Type de fixation
tools.lock_mount.help = Rigide tourne avec la cible, Par défaut suit son cap, Souple seulement sa position.
tools.lock_move = Verrouiller ce mouvement
tools.lock_move.help = Chaque marqueur du mouvement est fixé à la cible, chacun gardant la vue qu'il montre maintenant.
tools.lock_target = Cible du verrouillage
tools.lock_target.help = Le personnage, cheval ou véhicule auquel le mouvement se verrouille.
tools.stretch = Étirer le mouvement
tools.stretch.help = {key_select} applique: le mouvement se joue sur cette part de son temps (au-delà de 100%, plus lent). L'action n'est pas touchée; les marqueurs après le mouvement ne bougent que si l'espacement l'exige.
tools.unlock = Déverrouiller ce mouvement
tools.unlock.help = Les marqueurs du mouvement lâchent leur cible et restent là où ils sont maintenant.

