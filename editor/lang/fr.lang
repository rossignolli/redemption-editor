# [settings]
settings.buffer = Tampon de replay: {state}
settings.buffer.body = Le jeu enregistre en permanence, comme le mode replay de l'Éditeur Rockstar. {key_save_buffer} enregistre son contenu; {key_record} marque un enregistrement à l'intérieur.
settings.compress = Compression auto des clips: {state}
settings.compress.body = Les clips ni lus ni enregistrés depuis un moment sont compressés en arrière-plan, environ 3 fois plus petits. Ils s'ouvrent comme avant; le premier chargement prend une fraction de seconde de plus.
settings.compress_after = Compresser après: {count} {unit}
settings.compress_after.body = Combien de temps un clip reste inutilisé avant d'être compressé. Lire ou enregistrer un clip compte comme une utilisation.
settings.compress_now = Compresser les anciens clips maintenant
settings.compress_now.body = Compresser maintenant chaque clip plus ancien que le nombre de jours ci-dessus, sans attendre. Cela tourne en arrière-plan; le jeu continue.
settings.compress_waiting = Compression en attente...
settings.compressing = Compression {done} sur {total}...
settings.cutscenes = Cinématiques: {state}
settings.cutscenes.body = Passer: l'enregistrement se met en pause pendant une cinématique et le clip la saute directement. Enregistrer: les cinématiques sont gardées dans le clip.
settings.cutscenes.record = Enregistrer
settings.cutscenes.skip = Passer
settings.day = jour
settings.days = jours
settings.dead_eye = Sang-froid dans le replay: {state}
settings.dead_eye.body = Rejouer le Sang-froid et l'Œil de lynx enregistrés: l'effet d'écran du jeu et le ralenti. Désactivé: le replay joue ces moments à vitesse normale, sans l'effet.
settings.disk = Clips sur le disque: {size} dans {count} clips, {compressed} compressés ({saved} économisés).
settings.disk.reading = Clips sur le disque: lecture des clips...
settings.freeze = Figer le monde en pause: {state}
settings.freeze.body = Activé: un replay en pause reste immobile comme dans le mode photo (feu, fumée, eau, tissu, vent, son d'ambiance). Désactivé: le monde continue derrière le replay en pause.
settings.interface_scale = Échelle de l'interface : {pct} %
settings.interface_scale.body = La taille des menus, panneaux, textes et notifications de l'éditeur. À 100 %, elle est la même à toutes les résolutions ; plus grande, elle se lit mieux de loin, plus petite, elle laisse voir davantage l'image. Un écran 4:3 reste à 100 % au plus, et un petit écran ne descend pas sous sa taille à 100 %.
settings.length = Durée: {seconds} secondes
settings.length.body = Le nombre de secondes que garde le tampon. Il en garde moins quand la scène est lourde et que la limite de mémoire est atteinte d'abord. Ne limite pas un enregistrement manuel ({key_record}).
settings.lock_camera = Caméra bloquée en cinématique: {state}
settings.lock_camera.body = Activé: les marqueurs dans une cinématique enregistrée montrent la caméra propre de la cinématique. Désactivé: les caméras des marqueurs y fonctionnent comme partout ailleurs.
settings.memory = Mémoire: {mb} MB
settings.memory.body = Le maximum que le tampon peut utiliser; une ville animée prend environ 6 MB par seconde. Ne limite pas un enregistrement manuel ({key_record}): un long enregistrement est enregistré en plusieurs parties (ManualMaxMB dans RedemptionEditor.ini).
settings.rec_indicator = Indicateur d'enregistrement: {state}
settings.rec_indicator.body = L'avis REC pendant que le replay enregistre. Normal: toujours à l'écran. Bref: 3 secondes quand un enregistrement commence, s'arrête ou est sauvegardé. Masqué des captures: vous le voyez, les logiciels d'enregistrement d'écran (OBS, NVIDIA, Game Bar) non. Désactivé: aucun avis.
settings.rec_indicator.brief = Bref
settings.rec_indicator.fallback.fullscreen = Le jeu est en plein écran exclusif, où aucune fenêtre ne s'affiche par-dessus: Masqué des captures fonctionne comme Bref. En fenêtré ou en fenêtré sans bordure, il s'affiche.
settings.rec_indicator.fallback.window = Windows a refusé la fenêtre de l'indicateur: Masqué des captures fonctionne comme Bref. ReShade.log indique pourquoi.
settings.rec_indicator.fallback.windows = Masqué des captures nécessite Windows 10 version 2004 ou plus récent: il fonctionne ici comme Bref.
settings.rec_indicator.hidden = Masqué des captures
settings.rec_indicator.normal = Normal
settings.section.interface = INTERFACE
settings.section.playback = LECTURE
settings.section.recording = ENREGISTREMENT
settings.section.storage = STOCKAGE
settings.title = PARAMÈTRES DU REPLAY

