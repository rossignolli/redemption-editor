# [hud]
hud.buffer_off = Redemption Editor: le tampon de replay est désactivé.
hud.buffer_short = Redemption Editor: les {saved} dernières secondes ont été enregistrées, pas {asked}: la mémoire du tampon de replay ({mb} MB) se remplit plus vite dans les endroits animés. Augmentez Mémoire dans Paramètres du replay pour en garder plus.
hud.cut_failed = Redemption Editor: cette partie de l'enregistrement n'a pas pu être coupée, l'enregistrement manuel s'est donc arrêté.
hud.duplicate = Redemption Editor est désactivé: {other} (une ancienne copie du mod) est aussi installé. Supprimez ReplayProbe.asi, ReplayEditor.addon64 et ReplayEditorCore.dll du dossier du jeu et redémarrez le jeu.
hud.leave_replay = Redemption Editor: quittez d'abord le replay; le monde revient avec votre dernière sauvegarde.
hud.loading = Chargement
hud.loading_replay = Chargement du replay...
hud.loading_world = Chargement...
hud.manual_part_size = Redemption Editor: l'enregistrement a atteint sa limite de taille, la partie {part} est donc enregistrée comme un clip à part et l'enregistrement continue dans la partie {next}.
hud.manual_part_time = Redemption Editor: l'enregistrement a atteint sa limite de durée, la partie {part} est donc enregistrée comme un clip à part et l'enregistrement continue dans la partie {next}.
hud.marker_bound_delete = Redemption Editor: les marqueurs de début et de fin délimitent le clip; déplacez-les plutôt.
hud.marker_bounds = Redemption Editor: les marqueurs se placent entre les marqueurs de début et de fin du clip.
hud.marker_close = Redemption Editor: trop près d'un autre marqueur.
hud.marker_no_room = Redemption Editor: pas de place pour une copie ici.
hud.move_fit = Redemption Editor: le mouvement ne tient pas (la fin du clip, ou son marqueur de fin).
hud.move_three = Redemption Editor: un mouvement demande trois marqueurs liés par une fusion.
hud.no_memory_changes = Redemption Editor: pas assez de mémoire pour enregistrer les modifications. Elles restent dans le clip ouvert.
hud.no_memory_replay = Redemption Editor: pas assez de mémoire pour enregistrer le replay. Lisez-le et enregistrez-le depuis l'éditeur ({key_save}).
hud.paused = En pause
hud.pose_editor = Redemption Editor: fermez d'abord le Pose Editor (il utilise les poses des personnages).
hud.project_clip = {project}  -  clip {at} sur {count}: {clip}
hud.reload_failed = Redemption Editor: impossible de charger votre dernière sauvegarde; chargez-la depuis le menu pause (le monde a été vidé pour le replay).
hud.reload_gave_up = Redemption Editor: le monde n'a pas pu être rechargé après le replay; chargez votre dernière sauvegarde depuis le menu pause.
hud.reloaded_in_replay = Redemption Editor: le mod a été rechargé pendant un replay; votre dernière sauvegarde se charge maintenant.
hud.report_after_mark = Redemption Editor: fin du signalement en cours, le rapport suit.
hud.report_busy = Redemption Editor: un rapport est encore en cours d'enregistrement.
hud.report_failed = Redemption Editor: le rapport n'a pas pu être enregistré ({error}).
hud.report_saved = Rapport enregistré: {path} ({mb} MB)
hud.report_saved_folder = Rapport enregistré: {path} (dossier; le zip a échoué: {error})
hud.save_failed = Redemption Editor: impossible d'enregistrer le replay.
hud.save_held = Redemption Editor: impossible d'enregistrer {name} ({error}). Le replay est gardé en mémoire et l'enregistrement est retenté; libérez de l'espace disque.
hud.saved_now = Redemption Editor: {name} est maintenant enregistré.
hud.saves_failing = Redemption Editor: l'enregistrement échoue, l'enregistrement s'est donc arrêté ici. Les parties non enregistrées sont gardées en mémoire et l'enregistrement est retenté; libérez de l'espace disque.
hud.saves_failing_manual = Redemption Editor: l'enregistrement échoue, l'enregistrement manuel s'est donc arrêté ici. Les parties non enregistrées sont gardées en mémoire et l'enregistrement est retenté.
hud.session_reset = Redemption Editor: le jeu a chargé pendant l'enregistrement; cet enregistrement a été abandonné.
hud.world.mission = Redemption Editor: vous êtes en mission. Le replay peut montrer des restes de la mission (objets en trop, portes, accessoires) et certaines choses peuvent sembler incorrectes.
hud.world.no_reload = le rechargement de la sauvegarde n'est pas disponible
hud.world.no_save = aucune sauvegarde trouvée où revenir
hud.world.online = en ligne
hud.world.refused = Redemption Editor: WorldModel=gta n'a pas vidé le monde ({why}); le replay se déroule comme avant.
hud.world_cleared = Redemption Editor: le monde est vidé pour le replay; quitter le replay charge votre dernière sauvegarde.

