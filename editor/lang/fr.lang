spline.curve_shape.chordal = " Actuellement: Cordale."
spline.curve_shape.help = L'espacement Catmull-Rom: 0 Uniforme (virages larges), 0.5 Centripète, 1 Cordale (garde serrées les portions courtes).
spline.curve_shape.natural = " Sans effet avec le profil Naturel (une courbe sur les temps des marqueurs n'a pas d'espacement à choisir)."
spline.curve_shape.uniform = " Actuellement: Uniforme."
spline.defaults = Spline par défaut
spline.defaults.help = Profil de vitesse, forme de courbe, adoucissement, poids de la caméra et canaux utilisés par chaque marqueur Spline sauf s'il définit les siens.
spline.defaults.marker_help = Les valeurs utilisées par chaque marqueur sauf s'il définit les siennes (enregistrées dans RedemptionEditor.ini).
spline.ease_in = Accélération
spline.ease_in.help = La part du segment passée à accélérer depuis l'arrêt (il arrive quand même à l'heure). Position, rotation, zoom et cadrage s'adoucissent ensemble.
spline.ease_out = Décélération
spline.ease_out.help = La part du segment passée à ralentir jusqu'à l'arrêt au marqueur suivant. Si Accélération plus Décélération dépasse 1, les deux sont réduites.
spline.left_past_zero = " Gauche au-delà de 0: retour à la valeur par défaut."
spline.position = Position spline
spline.position.help = Désactivé: la position de la caméra va en ligne droite entre les marqueurs (avec l'adoucissement).
spline.profile = Profil de vitesse
spline.profile.continuous = Continu
spline.profile.help = Naturel: la courbe sur les temps des marqueurs (elle ralentit dans les virages serrés). Continu: une seule vitesse sur tout le mouvement, chaque marqueur atteint à l'heure. Par segment: une vitesse régulière dans chaque segment.
spline.profile.natural = Naturel
spline.profile.per_segment = Par segment
spline.reset_defaults = Réinitialiser les défauts
spline.reset_defaults.help = Naturel, Forme de courbe 1.00, sans adoucissement, sans poids, tous les canaux activés. Enregistré dans RedemptionEditor.ini.
spline.rotation = Rotation spline
spline.rotation.help = Désactivé: la rotation tourne en ligne droite entre les marqueurs (avec l'adoucissement).
spline.types = " {key_select} pour saisir un nombre."
spline.use_defaults = Utiliser les défauts
spline.use_defaults.help = Chaque ligne de ce marqueur revient à la Spline par défaut.
spline.weight = Poids de la caméra
spline.weight.help = Tire la courbe vers une B-spline: la caméra coupe à l'intérieur des virages comme si elle avait une masse, sans jamais dépasser un marqueur. Seulement pendant la lecture et l'export; en pause, la caméra reste sur les marqueurs.
spline.zoom = Zoom spline
spline.zoom.help = Désactivé: le champ de vision change en ligne droite. Activé: une courbe qui ne dépasse jamais sa cible pour revenir ensuite.

