# [tools]
tools.duplicate = Duplikuj
tools.duplicate.help = Kopia w połowie drogi do następnego znacznika (2 s dalej po ostatnim): nowy punkt do kształtowania krzywej.
tools.even_speed = Wyrównaj prędkość
tools.even_speed.help = Wewnętrzne znaczniki ruchu przestawione w czasie według odległości: kamera porusza się z jedną prędkością. Pierwszy i ostatni zachowują swoje czasy.
tools.even_times = Wyrównaj czasy
tools.even_times.help = Wewnętrzne znaczniki ruchu w równych odstępach czasu między pierwszym a ostatnim.
tools.lock_all = Zablokuj wszystkie znaczniki
tools.lock_all.help = Każdy wolny znacznik klipu porusza się z celem, a każdy zachowuje swój widok.
tools.lock_mount = Mocowanie blokady
tools.lock_mount.help = Sztywny obraca się z celem, Domyślny podąża za jego kierunkiem, Elastyczny tylko za jego pozycją.
tools.lock_move = Zablokuj ten ruch
tools.lock_move.help = Każdy znacznik ruchu porusza się z celem, zachowując widok, który teraz pokazuje.
tools.lock_target = Cel blokady
tools.lock_target.help = Postać, koń lub pojazd, do którego blokuje się ruch.
tools.stretch = Rozciągnij ruch
tools.stretch.help = {key_select} zatwierdza: ruch trwa przez taki odsetek swojego czasu (powyżej 100% wolniej). Akcja nie jest zmieniana; znaczniki po ruchu przesuwają się tylko wtedy, gdy wymaga tego odstęp.
tools.unlock = Odblokuj ten ruch
tools.unlock.help = Znaczniki ruchu porzucają cel i zostają tam, gdzie teraz są.

