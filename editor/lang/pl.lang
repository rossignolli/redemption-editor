spline.ease_in = Łagodny start
spline.ease_in.help = Część odcinka poświęcona na rozpędzanie się od zera (i tak dociera na czas). Pozycja, obrót, zoom i kadrowanie łagodnieją razem.
spline.ease_out = Łagodny koniec
spline.ease_out.help = Część odcinka poświęcona na zwalnianie do zatrzymania na następnym znaczniku. Łagodny start plus Łagodny koniec powyżej 1 są proporcjonalnie zmniejszane.
spline.left_past_zero = " W lewo poniżej 0: powrót do domyślnej."
spline.position = Pozycja Spline
spline.position.help = Wył.: pozycja kamery biegnie prosto między znacznikami (z łagodzeniem).
spline.profile = Profil prędkości
spline.profile.continuous = Ciągły
spline.profile.help = Naturalny: krzywa po czasach znaczników (zwalnia w ciasnych łukach). Ciągły: jedna prędkość przez cały ruch, każdy znacznik osiągnięty na czas. Na odcinek: równa prędkość w każdym odcinku.
spline.profile.natural = Naturalny
spline.profile.per_segment = Na odcinek
spline.reset_defaults = Resetuj domyślne
spline.reset_defaults.help = Naturalny, Kształt krzywej 1.00, bez łagodzenia, bez masy, wszystkie kanały wł. Zapisane w RedemptionEditor.ini.
spline.rotation = Obrót Spline
spline.rotation.help = Wył.: obrót zmienia się prosto między znacznikami (z łagodzeniem).
spline.types = " {key_select} wpisuje liczbę."
spline.use_defaults = Użyj domyślnych
spline.use_defaults.help = Każdy rząd tego znacznika wraca do Ustawień domyślnych Spline.
spline.weight = Masa kamery
spline.weight.help = Przyciąga krzywą w stronę B-spline: kamera ścina zakręty od wewnątrz, jakby miała masę, nigdy nie mijając znacznika. Tylko podczas odtwarzania i eksportu; w pauzie kamera stoi na znacznikach.
spline.zoom = Zoom Spline
spline.zoom.help = Wył.: pole widzenia zmienia się liniowo. Wł.: krzywa, która nigdy nie mija celu i nie wraca.

# [storage]
storage.body = Windows odmówił zapisu we wszystkich folderach, w których edytor zapisuje dane, więc klipy, projekty, raporty i zmienione ustawienia nie są zachowywane. Folder gry: {game}. Foldery zapasowe: {fallback}. Nadaj swojemu kontu Windows prawo zapisu do jednego z nich albo przenieś grę poza Program Files.
storage.title = Redemption Editor nie może niczego zapisać

