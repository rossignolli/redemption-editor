settings.freeze = Zamrażaj świat w pauzie: {state}
settings.freeze.body = Wł.: wstrzymana powtórka stoi w miejscu jak w trybie fotograficznym (ogień, dym, woda, tkaniny, wiatr, dźwięki otoczenia). Wył.: świat toczy się dalej za wstrzymaną powtórką.
settings.interface_scale = Skala interfejsu: {pct}%
settings.interface_scale.body = Rozmiar menu, paneli, tekstów i powiadomień edytora. Przy 100% wygląda tak samo w każdej rozdzielczości; większy łatwiej czytać z daleka, mniejszy odsłania więcej obrazu. Ekran 4:3 zostaje najwyżej przy 100%, a mały ekran nie schodzi poniżej swojego rozmiaru przy 100%.
settings.length = Długość: {seconds} s
settings.length.body = Ile sekund przechowuje bufor. Przechowuje mniej, gdy scena jest ciężka i najpierw kończy się limit pamięci. Nie ogranicza ręcznego nagrania ({key_record}).
settings.lock_camera = Blokuj kamerę w przerywnikach: {state}
settings.lock_camera.body = Wł.: znaczniki wewnątrz nagranego przerywnika filmowego pokazują jego własną kamerę. Wył.: kamery znaczników działają tam jak wszędzie indziej.
settings.memory = Pamięć: {mb} MB
settings.memory.body = Najwięcej, ile bufor może użyć; ruchliwe miasto zajmuje około 6 MB na sekundę. Nie ogranicza ręcznego nagrania ({key_record}): długie nagranie jest zapisywane w częściach (ManualMaxMB w RedemptionEditor.ini).
settings.rec_indicator = Wskaźnik nagrywania: {state}
settings.rec_indicator.body = Komunikat REC podczas nagrywania powtórki. Normalny: zawsze na ekranie. Krótki: przez 3 sekundy, gdy nagrywanie się zaczyna, kończy lub zapisuje. Ukryty przed przechwytywaniem: ty go widzisz, programy nagrywające ekran (OBS, NVIDIA, Game Bar) nie. Wył.: bez komunikatu.
settings.rec_indicator.brief = Krótki
settings.rec_indicator.fallback.fullscreen = Gra działa w wyłącznym trybie pełnoekranowym, w którym nad nią nie pojawia się żadne okno: Ukryty przed przechwytywaniem działa jak Krótki. W oknie lub w oknie bez ramki jest widoczny.
settings.rec_indicator.fallback.window = Windows odrzucił okno wskaźnika: Ukryty przed przechwytywaniem działa jak Krótki. Przyczynę podaje ReShade.log.
settings.rec_indicator.fallback.windows = Ukryty przed przechwytywaniem wymaga systemu Windows 10 w wersji 2004 lub nowszej: tutaj działa jak Krótki.
