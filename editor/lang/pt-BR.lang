# [settings]
settings.buffer = Buffer de Replay: {state}
settings.buffer.body = O jogo grava o tempo todo, como o modo replay do Editor Rockstar. {key_save_buffer} salva o que ele guarda; {key_record} marca uma gravação dentro dele.
settings.compress = Comprimir clipes: {state}
settings.compress.body = Clipes não tocados nem salvos há algum tempo são comprimidos ao fundo, umas 3 vezes menores. Eles abrem como antes; a primeira carga leva uma fração de segundo a mais.
settings.compress_after = Comprimir após: {count} {unit}
settings.compress_after.body = Quanto tempo um clipe fica sem uso antes de ser comprimido. Tocar ou salvar um clipe conta como uso.
settings.compress_now = Comprimir clipes antigos agora
settings.compress_now.body = Comprime agora cada clipe mais antigo que os dias acima, sem esperar. Roda ao fundo; o jogo continua.
settings.compress_waiting = Compressão aguardando...
settings.compressing = Comprimindo {done} de {total}...
settings.cutscenes = Cinemáticas: {state}
settings.cutscenes.body = Pular: a gravação pausa enquanto uma cinemática toca e o clipe corta direto para depois dela. Gravar: as cinemáticas ficam no clipe.
settings.cutscenes.record = Gravar
settings.cutscenes.skip = Pular
settings.day = dia
settings.days = dias
settings.dead_eye = Dead Eye no replay: {state}
settings.dead_eye.body = Reproduz o Dead Eye e o Eagle Eye gravados: o efeito de tela do jogo e a câmera lenta. Desligado: o replay toca esses momentos na velocidade normal, sem o efeito.
settings.disk = Clipes no disco: {size} em {count} clipes, {compressed} comprimidos ({saved} economizados).
settings.disk.reading = Clipes no disco: lendo clipes...
settings.freeze = Congelar o mundo na pausa: {state}
settings.freeze.body = Ligado: um replay pausado fica parado como no Modo Foto (fogo, fumaça, água, tecido, vento, som ambiente). Desligado: o mundo continua atrás do replay pausado.
settings.interface_scale = Escala da interface: {pct}%
settings.interface_scale.body = O tamanho dos menus, painéis, textos e avisos do editor. Em 100% fica igual em qualquer resolução; maior lê melhor de longe, menor deixa ver mais da imagem. Uma tela 4:3 fica em no máximo 100%, e uma tela pequena não fica menor que o seu tamanho em 100%.
settings.length = Duração: {seconds} segundos
settings.length.body = Quantos segundos o buffer guarda. Ele guarda menos quando a cena é pesada e o limite de memória chega antes. Não limita uma gravação manual ({key_record}).
settings.lock_camera = Travar câmera nas cinemáticas: {state}
settings.lock_camera.body = Ligado: marcadores dentro de uma cinemática gravada mostram a câmera da própria cinemática. Desligado: as câmeras dos marcadores funcionam ali como em qualquer lugar.
settings.memory = Memória: {mb} MB
settings.memory.body = O máximo que o buffer pode usar; uma cidade movimentada ocupa uns 6 MB por segundo. Não limita uma gravação manual ({key_record}): uma gravação longa é salva em partes (ManualMaxMB no RedemptionEditor.ini).
settings.rec_indicator = Indicador de gravação: {state}
settings.rec_indicator.body = O aviso REC enquanto o replay grava. Normal: sempre na tela. Breve: por 3 segundos quando uma gravação começa, para ou é salva. Oculto na captura: você vê, gravadores de tela (OBS, NVIDIA, Game Bar) não. Desligado: sem aviso.
