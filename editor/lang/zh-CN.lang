spline.curve_shape.help = Catmull-Rom参数化：0为均匀（转弯较宽），0.5为向心，1为弦长（短段收得更紧）。
spline.curve_shape.natural = " 在自然速度曲线下无效（基于标记点时间的曲线没有可选的参数化）。"
spline.curve_shape.uniform = " 当前：均匀。"
spline.defaults = 样条默认值
spline.defaults.help = 每个样条标记点使用的速度曲线、曲线形状、缓动、镜头重量和通道，除非它设置了自己的值。
spline.defaults.marker_help = 每个标记点使用的数值，除非它设置了自己的值（保存在RedemptionEditor.ini中）。
spline.ease_in = 缓入
spline.ease_in.help = 该段中从静止加速所用的比例（仍会准时到达）。位置、旋转、变焦和构图一起缓动。
spline.ease_out = 缓出
spline.ease_out.help = 该段中减速至在下一个标记点静止所用的比例。缓入加缓出超过1时会按比例缩小。
spline.left_past_zero = " 向左越过0：恢复默认值。"
spline.position = 样条位置
spline.position.help = 关：镜头位置在标记点之间直线移动（带缓动）。
spline.profile = 速度曲线
spline.profile.continuous = 连续
spline.profile.help = 自然：基于标记点时间的曲线（进入急弯时减速）。连续：整个运镜一个速度，每个标记点准时到达。分段：每段内速度均匀。
spline.profile.natural = 自然
spline.profile.per_segment = 分段
spline.reset_defaults = 重置默认值
spline.reset_defaults.help = 自然、曲线形状1.00、无缓动、无重量、所有通道开启。保存在RedemptionEditor.ini中。
spline.rotation = 样条旋转
spline.rotation.help = 关：旋转在标记点之间直线转动（带缓动）。
spline.types = " 按{key_select}输入数字。"
spline.use_defaults = 使用默认值
spline.use_defaults.help = 此标记点的每一行恢复为样条默认值。
spline.weight = 镜头重量
spline.weight.help = 将曲线拉向B-spline：镜头像有质量一样切入弯角内侧，但从不越过标记点。仅在播放和导出时生效；暂停时镜头停在标记点上。
spline.zoom = 样条变焦
spline.zoom.help = 关：视野直线变化。开：一条从不越过目标值再折返的曲线。

# [storage]
storage.body = Windows 拒绝了编辑器用于保存的所有文件夹，因此片段、项目、报告和更改的设置都不会被保留。游戏文件夹：{game}。备用文件夹：{fallback}。请为你的 Windows 账户授予其中一个文件夹的写入权限，或将游戏移出 Program Files。
storage.title = Redemption Editor 无法保存任何内容

