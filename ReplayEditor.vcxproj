    <ClInclude Include="src\ui_scale.h" />
    <ClInclude Include="src\editor_protocol.h" />
    <ClInclude Include="editor\render_export\export_types.h" />
    <ClInclude Include="editor\render_export\readback_ring.h" />
    <ClInclude Include="editor\render_export\ffmpeg_args.h" />
    <ClInclude Include="editor\render_export\gpu_export.h" />
    <ClInclude Include="editor\render_export\convert_ref.h" />
    <ClInclude Include="editor\render_export\shaders\export_convert_spirv.h" />
    <ClInclude Include="editor\render_export\encoder_sink.h" />
    <ClInclude Include="editor\render_export\encoder_select.h" />
