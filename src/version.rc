// Version information of the shipped binaries (the Details tab of a file's
// properties). Built by every project that sets RedemptionVersionBinary;
// RedemptionEditor.props passes the numbers read from VERSION.
//   RE_BINARY 1 = RedemptionEditor.asi, 2 = RedemptionEditorCore.dll,
//             3 = RedemptionEditor.addon64, 4 = RedemptionEditorHost.dll

#include <winresrc.h>

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

#define RE_STR2(x) #x
#define RE_STR(x) RE_STR2(x)

#if RE_BINARY == 1
#define RE_FILE_DESCRIPTION "Redemption Editor (Script Hook RDR2 script)"
#define RE_ORIGINAL_FILENAME "RedemptionEditor.asi"
#elif RE_BINARY == 2
#define RE_FILE_DESCRIPTION "Redemption Editor core"
#define RE_ORIGINAL_FILENAME "RedemptionEditorCore.dll"
#elif RE_BINARY == 3
#define RE_FILE_DESCRIPTION "Redemption Editor (ReShade add-on)"
#define RE_ORIGINAL_FILENAME "RedemptionEditor.addon64"
#elif RE_BINARY == 4
#define RE_FILE_DESCRIPTION "Redemption Editor display host"
#define RE_ORIGINAL_FILENAME "RedemptionEditorHost.dll"
#else
#error "RE_BINARY must be 1 to 4"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RE_VER_MAJOR,RE_VER_MINOR,RE_VER_PATCH,0
 PRODUCTVERSION RE_VER_MAJOR,RE_VER_MINOR,RE_VER_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Redemption Editor project"
            VALUE "FileDescription", RE_FILE_DESCRIPTION
            VALUE "FileVersion", RE_STR(RE_VERSION_TEXT)
            VALUE "InternalName", RE_ORIGINAL_FILENAME
            VALUE "LegalCopyright", "Copyright (C) 2026 the Redemption Editor authors. Licensed under the GNU GPL v3."
            VALUE "OriginalFilename", RE_ORIGINAL_FILENAME
            VALUE "ProductName", "Redemption Editor"
            VALUE "ProductVersion", RE_STR(RE_VERSION_TEXT)
            VALUE "Comments", "Open source replay editor for Red Dead Redemption 2 Story Mode. https://github.com/rossignolli/redemption-editor"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
